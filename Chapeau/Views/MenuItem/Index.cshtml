@using Chapeau.Enums
@model Chapeau.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "MenuItems";
}

<h1 class="display-4 pb-4">Le MENU</h1>

<form method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <select name="selectedMenuId" class="form-select" onchange="this.form.submit()">
                <option value="">All Menus</option>

                @foreach (var menu in Model.Menus)
                {
                    <option value="@menu.MenuId" selected="@(Model.SelectedMenuId == menu.MenuId)">
                        @menu.MenuName.ToString().ToUpper()
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select name="selectedCategory" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                <option value="@((int)category)"
                        selected="@(Model.SelectedCategory == category)">
                        @category.ToString().Replace("CoffeeAndTea", "Coffee & Tea").ToUpper()
                </option>
                                
                }
            </select>
        </div>
    </div>
</form>

<table>
    <tbody>

        @foreach (var menu in Model.Menus)
        {
            if (Model.SelectedMenuId != null && Model.SelectedMenuId != menu.MenuId)
            {
                continue;
            }
            <tr style="height:35px;"></tr>
            <tr>
                <td colspan="2">
                    <strong>@menu.MenuName.ToUpper()</strong>
                </td>
            </tr>

            @foreach (var category in Model.Categories)
            {
                if (Model.SelectedCategory != null && Model.SelectedCategory != category)
                {
                    continue;
                }

                List<MenuItem> itemsInGroup = new List<MenuItem>();

                foreach (var x in Model.MenuItems)
                {
                    if (x.Menu.MenuId == menu.MenuId &&
                    x.Category == category)
                    {
                        itemsInGroup.Add(x);
                    }
                }

                if (itemsInGroup.Count == 0)
                    continue;

                <tr style="height:35px;"></tr>
                <tr>
                    <td colspan="2">
                        <em>@category.ToString().Replace("CoffeeAndTea", "Coffee & Tea").ToUpper()</em>
                    </td>
                </tr>

                foreach (var item in itemsInGroup)
                {
                    <tr>
                        <td class="pe-3">@item.MenuItemName</td>
                        <td class="pe-3">
                            <small class="@item.StockCssClass">
                                @item.StockStatus
                            </small>
                        </td>
                        <td>€ @item.MenuItemPrice.ToString("0.00")</td>
                    </tr>
                }
            }
        }
    </tbody>
</table>