@model List<Chapeau.Models.Order>
@using Chapeau.Enums

@{
    ViewData["Title"] = "Bar Orders";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Bar Orders</h1>

        <div>
            <button class="btn btn-outline-primary" onclick="location.reload()">Refresh</button>
            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-info">Kitchen Orders</a>
            <a asp-action="FinishedOrders" class="btn btn-outline-secondary">Finished Orders</a>
        </div>
    </div>

    <div class="row">

        @foreach (var order in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card shadow-sm border h-100">

                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Table @order.Table.TableId</h4>
                        <span class="badge bg-secondary">@order.OrderStatus</span>
                    </div>

                    <div class="card-body">

                        <p><strong>Order Time:</strong> @order.OrderTime.ToShortTimeString()</p>

                        <hr />

                        @foreach (var item in order.OrderItems.Where(item =>
                                            item.MenuItem.Menu.Card == Card.Drink))
                        {
                            @await Html.PartialAsync("_OrderItemCard", item)

                            @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                            {
                                <form asp-action="UpdateItemStatus" method="post">
                                    <input type="hidden" name="orderItem.OrderItemId" value="@item.OrderItemId" />
                                    <input type="hidden" name="status" value="@OrderItemStatus.Preparing" />
                                    <button type="submit" class="btn btn-secondary btn-sm mt-2 w-100">
                                        Start Preparing
                                    </button>
                                </form>
                            }
                            else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                            {
                                <form asp-action="UpdateItemStatus" method="post">
                                    <input type="hidden" name="orderItem.OrderItemId" value="@item.OrderItemId" />
                                    <input type="hidden" name="status" value="@OrderItemStatus.Ready" />
                                    <button type="submit" class="btn btn-success btn-sm mt-2 w-100">
                                        Mark Ready
                                    </button>
                                </form>
                            }
                        }

                        <hr />

                        @if (order.OrderStatus == OrderStatus.Ordered)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="order.OrderId" value="@order.OrderId" />
                                <input type="hidden" name="status" value="@OrderStatus.Preparing" />
                                <button type="submit" class="btn btn-warning w-100">
                                    Start Preparing
                                </button>
                            </form>
                        }
                        else if (order.OrderStatus == OrderStatus.Preparing)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="order.OrderId" value="@order.OrderId" />
                                <input type="hidden" name="status" value="@OrderStatus.Ready" />
                                <button type="submit" class="btn btn-success w-100">
                                    Mark Ready
                                </button>
                            </form>
                        }
                        else if (order.OrderStatus == OrderStatus.Ready)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="order.OrderId" value="@order.OrderId" />
                                <input type="hidden" name="status" value="@OrderStatus.Served" />
                                <button type="submit" class="btn btn-success w-100">
                                    Ready To Serve
                                </button>
                            </form>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>