@model List<Chapeau.Models.Order>
@using Chapeau.Models
@using Chapeau.Enums

@{
    ViewData["Title"] = "Finished Bar Orders";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Finished Bar Orders</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">View Orders</a>
    </div>

    <div class="row">

        @foreach (var order in Model)
        {
            var drinkItems = order.OrderItems?
            .Where(i => i.MenuItem?.Menu?.Card == Card.Drink)
            .ToList();

            if (drinkItems == null || !drinkItems.Any()) continue;

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card shadow-sm border">

                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Table @order.Table.TableId</h4>
                        @if (order.OrderStatus == OrderStatus.Served)
                        {
                            <span class="badge bg-success">Served</span>
                        }
                        else if (order.OrderStatus == OrderStatus.Settled)
                        {
                            <span class="badge bg-dark">Completed</span>
                        }
                    </div>

                    <div class="card-body">

                        <p><strong>Order Time:</strong> @order.OrderTime.ToShortTimeString()</p>
                        <p><strong>Waiting Time:</strong> @order.WaitingTime</p>

                        <hr />

                        @foreach (var item in drinkItems)
                        {
                            <partial name="OrderItemCard" model="item" />
                        }

                    </div>
                </div>
            </div>
        }

    </div>

</div>