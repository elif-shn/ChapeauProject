@using Chapeau.Enums
@model Chapeau.ViewModels.SplitPaymentViewModel

@{
    ViewData["Title"] = "Split Bill Equally";
}

<div class="split-page">
    <div class="split-header">
        <div>
            <h1>Split Bill Equally</h1>
            <p>Divide the remaining bill equally between guests.</p>
        </div>

        <a asp-controller="Payment"
           asp-action="LoadBill"
           asp-route-tableId="@Model.TableId"
           class="back-link">
            Back to Bill
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message">@TempData["ErrorMessage"]</div>
    }

    <div class="split-summary">
        <div>
            <span>Table</span>
            <strong>@Model.TableId</strong>
        </div>

        <div>
            <span>Total Bill</span>
            <strong>€ @Model.TotalBillAmount.ToString("0.00")</strong>
        </div>

        <div>
            <span>Already Paid</span>
            <strong>€ @Model.TotalPaidAmount.ToString("0.00")</strong>
        </div>

        <div>
            <span>Remaining</span>
            <strong>€ @Model.RemainingAmount.ToString("0.00")</strong>
        </div>
    </div>

    <form asp-controller="Payment" asp-action="SplitEqual" method="post">
        <input type="hidden" asp-for="TableId" />
        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="TotalBillAmount" />
        <input type="hidden" asp-for="TotalPaidAmount" />
        <input type="hidden" asp-for="RemainingAmount" />
        <input type="hidden" asp-for="IsEqualSplit" value="true" />

        <div class="people-card">
            <label>Number Of People</label>

            <input asp-for="NumberOfPeople"
                   id="numberOfPeople"
                   type="number"
                   min="1"
                   max="10"
                   onfocus="clearZero(this)"
                   oninput="createPaymentRows()" />

            <p>
                Amount per person:
                <strong>€ <span id="amountPerPerson">0.00</span></strong>
            </p>
        </div>

        <div class="payment-card">
            <h2>Guest Payments</h2>
            <div id="paymentRows"></div>
        </div>

        <button type="submit" class="confirm-button">
            Confirm Split Payment
        </button>
    </form>
</div>
<style>
    .split-page {
        max-width: 1100px;
        margin: 30px auto;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .split-header {
        background: linear-gradient(135deg,#1f2937,#374151);
        color: white;
        border-radius: 18px;
        padding: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

        .split-header h1 {
            margin: 0;
        }

        .split-header p {
            margin-top: 8px;
            color: #d1d5db;
        }

    .back-link {
        background: white;
        color: #1f2937;
        padding: 13px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
    }

    .alert-message {
        background: #fee2e2;
        color: #991b1b;
        padding: 14px;
        border-radius: 12px;
        margin-bottom: 18px;
        font-weight: bold;
    }

    .split-summary {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

        .split-summary div,
        .people-card,
        .payment-card {
            background: white;
            padding: 22px;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }

    .people-card,
    .payment-card {
        margin-bottom: 22px;
    }

        .people-card input,
        .person-row input,
        .person-row select {
            width: 100%;
            padding: 11px;
            border: 1px solid #d1d5db;
            border-radius: 9px;
        }

    .person-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 2fr;
        gap: 12px;
        padding: 16px;
        background: #f9fafb;
        border-radius: 14px;
        margin-bottom: 14px;
    }

    .confirm-button {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 13px;
        background: #16a34a;
        color: white;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
    }

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        appearance: textfield;
        -moz-appearance: textfield;
    }

    @@media (max-width:900px) {
        .split-summary {
            grid-template-columns: 1fr 1fr;
        }

        .person-row {
            grid-template-columns: 1fr;
        }

        .split-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>

<script>
    function clearZero(input) {
        if (input.value === "0" || input.value === "0.00") {
            input.value = "";
        }
    }

    function createPaymentRows() {

        var people = parseInt(document.getElementById("numberOfPeople").value);

        if (isNaN(people) || people < 1)
            people = 1;

        var remaining = parseFloat('@Model.RemainingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
        var amount = remaining / people;

        document.getElementById("amountPerPerson").innerText = amount.toFixed(2);

        var container = document.getElementById("paymentRows");
        container.innerHTML = "";

        for (var i = 0; i < people; i++) {

            container.innerHTML +=
                '<div class="person-row">' +

                '<div><label>Amount</label>' +
                '<input name="Payments[' + i + '].AmountToPay" value="' + amount.toFixed(2) + '" readonly></div>' +

                '<div><label>Tip</label>' +
                '<input name="Payments[' + i + '].TipAmount" type="number" min="0" step="0.01" value="0" onfocus="clearZero(this)"></div>' +

                '<div><label>Payment Method</label>' +
                '<select name="Payments[' + i + '].PaymentMethod">' +
                '<option value="1">Cash</option>' +
                '<option value="2">Debit Card</option>' +
                '<option value="3">Credit Card</option>' +
                '</select></div>' +

                '<div><label>Feedback</label>' +
                '<input name="Payments[' + i + '].Feedback" placeholder="Guest feedback"></div>' +

                '</div>';
        }
    }

    createPaymentRows();
</script>