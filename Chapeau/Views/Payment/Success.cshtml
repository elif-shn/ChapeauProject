@{
    ViewData["Title"] = "Payment Success";
}

<div class="success-page">
    <div class="success-card">
        <div class="success-icon">✓</div>
        <h1>Payment Completed</h1>
        <p>The payment has been saved successfully and the table is now free.</p>

        <a asp-controller="Payment" asp-action="Index" class="back-button">
            Back to Payment Dashboard
        </a>
    </div>
</div>

<style>
    .success-page {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial, sans-serif;
    }

    .success-card {
        background-color: white;
        padding: 45px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0,0,0,0.12);
        max-width: 500px;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        background-color: #16a34a;
        color: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 42px;
        margin: 0 auto 20px auto;
    }

    .success-card h1 {
        margin: 0;
        color: #111827;
    }

    .success-card p {
        color: #6b7280;
        margin: 16px 0 28px 0;
    }

    .back-button {
        display: inline-block;
        text-decoration: none;
        background-color: #2563eb;
        color: white;
        padding: 14px 22px;
        border-radius: 12px;
        font-weight: bold;
    }
</style>