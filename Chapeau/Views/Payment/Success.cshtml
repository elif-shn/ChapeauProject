@{
    ViewData["Title"] = "Payment Success";
}

<div class="container my-5 d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow border-0 text-center p-5" style="max-width: 550px; border-radius: 20px;">
        <div class="mb-4">
            <div class="display-1 text-success animate__animated animate__bounceIn">
                <i class="bi bi-check-circle-fill">✓</i>
            </div>
        </div>
        <h2 class="text-success fw-bold mb-3">Payment Successful!</h2>
        <p class="text-muted fs-5 mb-4">
            @if (TempData["SuccessMessage"] != null)
            {
                @TempData["SuccessMessage"]
            }
            else
            {
                <span>The transaction has been processed successfully.</span>
            }
        </p>
        <div class="p-3 bg-light rounded mb-4">
            <span class="text-secondary fw-bold">Order Reference ID:</span>
            <span class="text-dark fw-bold">#@ViewBag.OrderId</span>
        </div>
        <div class="d-grid gap-2">
            <a href="/Payment" class="btn btn-success btn-lg py-3 fw-bold shadow-sm" style="border-radius: 10px;">
                Go to Payment Dashboard
            </a>
            <a href="/" class="btn btn-outline-secondary btn-lg py-2" style="border-radius: 10px;">
                Back to Home
            </a>
        </div>
    </div>
</div>