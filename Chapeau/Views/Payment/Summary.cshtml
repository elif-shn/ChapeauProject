@model Chapeau.ViewModels.PaymentSummaryViewModel

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h3>Bill Settlement - Order #@Model.OrderId</h3>
        </div>
        <div class="col-md-6 text-end">
            <input type="text" id="orderSearch" class="form-control" placeholder="Search by Order ID...">
        </div>
    </div>

    <form asp-action="Create" asp-controller="Payment" method="post">
        <input type="hidden" name="OrderId" value="@Model.OrderId" />
        <input type="hidden" name="TotalAmount" value="@Model.GrandTotal" />
        <input type="hidden" name="Vat9" value="@Model.Vat9" />
        <input type="hidden" name="Vat21" value="@Model.Vat21" />

        <div class="row">
            <div class="col-md-7">
                <div class="card p-4 shadow-sm">
                    <h4>Bill Overview</h4>
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>@item.MenuItem.MenuItemName</td>
                                    <td>@item.OrderItemQuantity</td>
                                    <td>€@((item.MenuItem.MenuItemPrice * item.OrderItemQuantity).ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr />
                    <div class="text-end">
                        <p>Subtotal: €@Model.TotalAmount.ToString("F2")</p>
                        <p>VAT 9%: €@Model.Vat9.ToString("F2") | VAT 21%: €@Model.Vat21.ToString("F2")</p>
                        <h3>Total: €@Model.GrandTotal.ToString("F2")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card p-4 shadow-sm">
                    <h4>Payment Details</h4>
                    <div class="mb-3">
                        <label>Payment Method</label>
                        <select name="PaymentMethod" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="CreditCard">Credit Card</option>
                            <option value="DebitCard">Debit Card</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Tip Amount (€)</label>
                        <input type="number" name="TipAmount" class="form-control" step="0.01" value="0.00" min="0" />
                    </div>
                    <div class="mb-3">
                        <label>Feedback</label>
                        <textarea name="Feedback" class="form-control" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-lg">Complete Payment</button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    document.getElementById("orderSearch").addEventListener("keypress", function (event) {
        if (event.key === "Enter") {
            event.preventDefault();
            var orderId = event.target.value;
            if (orderId) {
                window.location.href = '/Payment/Summary?orderId=' + orderId;
            }
        }
    });
</script>