@model Chapeau.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Payment Dashboard";
}

<div class="container my-5" style="max-width: 950px;">
    <h2 class="text-center mb-4 text-primary fw-bold">Payment</h2>

    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-4">
            <form action="/Payment/Index" method="get">
                <label for="orderId" class="form-label fw-bold text-secondary">Select Table / Order to Pay:</label>
                <div class="input-group">
                    <select name="orderId" id="orderId" class="form-select form-select-lg">
                        <option value="">-- Choose Active Table --</option>
                        @if (Model.ActiveOrders != null)
                        {
                            @foreach (var order in Model.ActiveOrders)
                            {
                                if (order.Value == Model.OrderId.ToString())
                                {
                                    <option value="@order.Value" selected="selected">@order.Text</option>
                                }
                                else
                                {
                                    <option value="@order.Value">@order.Text</option>
                                }
                            }
                        }
                    </select>
                    <button type="submit" class="btn btn-primary px-4 btn-lg">Load Bill</button>
                </div>
            </form>
        </div>
    </div>

    <form action="/Payment/Process" method="post">
        <input type="hidden" name="orderId" value="@Model.OrderId" />
        <input type="hidden" name="tableId" value="@Model.TableId" />
        <input type="hidden" name="totalAmount" value="@Model.TotalAmount" />
        <input type="hidden" name="highVat" value="@Model.HighVat" />
        <input type="hidden" name="lowVat" value="@Model.LowVat" />

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 p-4 bg-white mb-4">
                    <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Payment Options</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Billing Type:</label>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="splitType" id="splitFull" value="full" checked onclick="toggleSplitOptions()" />
                            <label class="form-check-input-label" for="splitFull">Pay Full Bill</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="splitType" id="splitEqual" value="equal" onclick="toggleSplitOptions()" />
                            <label class="form-check-input-label" for="splitEqual">Split Equally (By Persons)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="splitType" id="splitCustom" value="custom" onclick="toggleSplitOptions()" />
                            <label class="form-check-input-label" for="splitCustom">Custom Amount Payment</label>
                        </div>
                    </div>

                    <div id="equalSplitSection" class="mb-3 d-none p-2 border rounded bg-light">
                        <label for="customSplits" class="form-label fw-bold">Number of People:</label>
                        <input type="number" name="customSplits" id="customSplits" class="form-control" value="2" min="2" oninput="calculateLiveSplit()" />
                        <div class="mt-2 text-primary fw-bold">Each Person Pays: €<span id="equalSplitAmount">0.00</span></div>
                    </div>

                    <div id="customSplitSection" class="mb-3 d-none p-2 border rounded bg-light">
                        <label for="customAmount" class="form-label fw-bold">Enter Amount to Pay Now:</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" name="customAmount" id="customAmount" class="form-control" step="0.01" value="0.00" min="0.01" />
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 p-4 bg-white">
                    <div class="mb-3">
                        <label for="tipAmount" class="form-label fw-bold">Add Tip (Optional):</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" name="tipAmount" id="tipAmount" class="form-control" step="0.01" value="0.00" min="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label fw-bold">Payment Method:</label>
                        <select name="paymentMethod" id="paymentMethod" class="form-select" required="required">
                            <option value="Credit Card">Credit Card</option>
                            <option value="Cash">Cash</option>
                        </select>
                    </div>

                    <div class="mb-0">
                        <label for="feedback" class="form-label fw-bold">Feedback:</label>
                        <textarea name="feedback" id="feedback" class="form-control" rows="2" placeholder="Write your feedback here..."></textarea>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm border-0 bg-light p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="border-bottom pb-2 mb-3 text-secondary">Bill Summary (Order ID: @Model.OrderId)</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span class="fw-bold">€@Model.SubTotal.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>High VAT (21%):</span>
                            <span>€@Model.HighVat.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-muted">
                            <span>Low VAT (9%):</span>
                            <span>€@Model.LowVat.ToString("0.00")</span>
                        </div>
                    </div>

                    <div class="border-top pt-3 mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="m-0 text-dark fw-bold">Total Bill:</h4>
                            <h3 class="m-0 text-success fw-bold">€@Model.TotalAmount.ToString("0.00")</h3>
                        </div>
                        <button type="submit" class="btn btn-success w-100 btn-lg py-3 fw-bold shadow-sm">
                            Complete Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function toggleSplitOptions() {
        var isFull = document.getElementById("splitFull").checked;
        var isEqual = document.getElementById("splitEqual").checked;
        var isCustom = document.getElementById("splitCustom").checked;

        document.getElementById("equalSplitSection").classList.toggle("d-none", !isEqual);
        document.getElementById("customSplitSection").classList.toggle("d-none", !isCustom);

        calculateLiveSplit();
    }

    function calculateLiveSplit() {
        var total = parseFloat("@Model.TotalAmount");
        if (document.getElementById("splitEqual").checked) {
            var splits = parseInt(document.getElementById("customSplits").value) || 2;
            var eachPays = total / splits;
            document.getElementById("equalSplitAmount").innerText = eachPays.toFixed(2);
        }
    }
</script>