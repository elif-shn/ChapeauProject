@model Chapeau.ViewModels.PaymentViewModel

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white text-center p-4">

            <h2>
                Payment Dashboard
            </h2>

            <p>
                Fast & Secure Restaurant Payment
            </p>

        </div>

        <div class="card-body p-5">

            <form asp-action="LoadBill" method="post">

                <div class="input-group input-group-lg mb-4">

                    <select name="selectedOrderId"
                            class="form-select">

                        <option selected disabled>
                            Select Order
                        </option>

                        @foreach (var order in Model.Orders)
                        {
                            <option value="@order.OrderId">
                                Order @order.OrderId
                            </option>
                        }

                    </select>

                    <button type="submit"
                            class="btn btn-success">

                        Load Bill

                    </button>

                </div>

            </form>

            @if (Model.OrderItems == null)
            {

                <div class="alert alert-info text-center shadow-sm">

                    <h4>
                        Bill Preview
                    </h4>

                    <p>
                        Select an order to load payment details.
                    </p>

                    <p>
                        Items • VAT • Tip • Payment Method • Feedback
                    </p>

                </div>

            }

            @if (Model.OrderItems != null)
            {

                <hr>

                <div class="alert alert-warning">

                    <h3>
                        Bill Summary
                    </h3>

                </div>

                <table class="table table-hover table-bordered">

                    <thead class="table-dark">

                        <tr>

                            <th>Item</th>
                            <th>Qty</th>
                            <th>Price</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>

                                <td>
                                    @item.MenuItem.MenuItemName
                                </td>

                                <td>
                                    @item.OrderItemQuantity
                                </td>

                                <td>
                                    €
                                    @((item.MenuItem.MenuItemPrice
                                                                * item.OrderItemQuantity)
                                                                .ToString("0.00"))
                        </td>

                            </tr>
                                        }

                    </tbody>

                </table>

                <div class="row">

                    <div class="col-md-4">

                        <div class="card bg-success text-white p-3 mb-3">

                            <h5>Total</h5>

                            <h4>
                                €
                                @Model.TotalAmount.ToString("0.00")
                            </h4>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card bg-info text-white p-3 mb-3">

                            <h5>VAT 9%</h5>

                            <h4>
                                €
                                @Model.Vat9.ToString("0.00")
                            </h4>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card bg-danger text-white p-3 mb-3">

                            <h5>VAT 21%</h5>

                            <h4>
                                €
                                @Model.Vat21.ToString("0.00")
                            </h4>

                        </div>

                    </div>

                </div>

                <form asp-action="Confirm" method="post">

                    <input type="hidden"
                           name="selectedOrderId"
                           value="@Model.SelectedOrderId" />

                    <div class="mb-3">

                        <label class="form-label">
                            Tip Amount
                        </label>

                        <input type="number"
                               step="0.01"
                               name="tipAmount"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Payment Method
                        </label>

                        <select name="paymentMethod"
                                class="form-select">

                            <option value="Cash">
                                Cash
                            </option>

                            <option value="DebitCard">
                                Debit Card
                            </option>

                            <option value="CreditCard">
                                Credit Card
                            </option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Feedback
                        </label>

    <textarea name="feedback"
          rows="4"
          class="form-control"></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-success btn-lg w-100">

                        Confirm Payment

                    </button>

                </form>

            }

        </div>

    </div>

</div>