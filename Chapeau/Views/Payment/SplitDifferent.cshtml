@using Chapeau.Enums
@model Chapeau.ViewModels.SplitPaymentViewModel

@{
    ViewData["Title"] = "Split Bill Different";
}

<div class="split-page">
    <h1>Split Bill With Different Payments</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message">@TempData["ErrorMessage"]</div>
    }

    <div class="summary-box">
        <p><strong>Table:</strong> @Model.TableId</p>
        <p><strong>Total Bill:</strong> € @Model.TotalBillAmount.ToString("0.00")</p>
        <p><strong>Already Paid:</strong> € @Model.TotalPaidAmount.ToString("0.00")</p>
        <p><strong>Remaining:</strong> € <span id="remainingAmount">@Model.RemainingAmount.ToString("0.00")</span></p>
    </div>

    <form asp-controller="Payment" asp-action="SplitDifferent" method="get" class="people-form">
        <input type="hidden" name="tableId" value="@Model.TableId" />

        <label>Number of people</label>

        <input type="number"
               name="numberOfPeople"
               value="@Model.NumberOfPeople"
               min="1"
               max="10"
               onfocus="clearZero(this)" />

        <button type="submit">Update</button>
    </form>

    <form asp-controller="Payment" asp-action="SplitDifferent" method="post">
        <input type="hidden" asp-for="TableId" />
        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="TotalBillAmount" />
        <input type="hidden" asp-for="TotalPaidAmount" />
        <input type="hidden" asp-for="RemainingAmount" />
        <input type="hidden" asp-for="NumberOfPeople" />

        <table class="split-table">
            <thead>
                <tr>
                    <th>Amount</th>
                    <th>Tip</th>
                    <th>Payment Method</th>
                    <th>Feedback</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Payments.Count; i++)
                {
                    <tr>
                        <td>
                            <input asp-for="Payments[i].AmountToPay"
                                   class="amount-input"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   onfocus="clearZero(this)"
                                   oninput="updateRemaining()" />
                        </td>

                        <td>
                            <input asp-for="Payments[i].TipAmount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   onfocus="clearZero(this)" />
                        </td>

                        <td>
                            <select asp-for="Payments[i].PaymentMethod">
                                <option value="@PaymentMethod.Cash">Cash</option>
                                <option value="@PaymentMethod.DebitCard">Debit Card</option>
                                <option value="@PaymentMethod.CreditCard">Credit Card</option>
                            </select>
                        </td>

                        <td>
                            <input asp-for="Payments[i].Feedback"
                                   placeholder="Guest feedback" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="confirm-button">Confirm Payments</button>
    </form>

    <a asp-controller="Payment"
       asp-action="LoadBill"
       asp-route-tableId="@Model.TableId"
       class="back-button">
        Back
    </a>
</div>
<style>
    .split-page {
        max-width: 1100px;
        margin: 30px auto;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .summary-box {
        background-color: white;
        padding: 24px;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        margin-bottom: 24px;
    }

    .people-form {
        display: flex;
        gap: 12px;
        align-items: end;
        margin-bottom: 20px;
    }

        .people-form label {
            font-weight: bold;
        }

        .people-form input,
        .split-table input,
        .split-table select {
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
        }

        .people-form button {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 11px 18px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    .split-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .split-table th {
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid #111827;
        }

        .split-table td {
            padding: 10px;
            border-bottom: 1px solid #e5e7eb;
        }

        .split-table input,
        .split-table select {
            width: 100%;
        }

    .confirm-button,
    .back-button {
        display: inline-block;
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 10px;
        font-weight: bold;
        text-decoration: none;
        cursor: pointer;
    }

    .confirm-button {
        background-color: #16a34a;
    }

    .back-button {
        margin-top: 16px;
        background-color: #6b7280;
    }

    .alert-message {
        background-color: #fee2e2;
        color: #991b1b;
        padding: 14px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-weight: bold;
    }

    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        appearance: textfield;
        -moz-appearance: textfield;
    }
</style>

<script>
    function clearZero(input) {
        if (input.value === "0" || input.value === "0.00") {
            input.value = "";
        }
    }

    function updateRemaining() {
        var originalRemaining = parseFloat('@Model.RemainingAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)');
        var amountInputs = document.getElementsByClassName("amount-input");
        var totalEntered = 0;

        for (var i = 0; i < amountInputs.length; i++) {
            var value = parseFloat(amountInputs[i].value);

            if (!isNaN(value)) {
                totalEntered += value;
            }
        }

        var newRemaining = originalRemaining - totalEntered;

        if (newRemaining < 0) {
            newRemaining = 0;
        }

        document.getElementById("remainingAmount").innerText = newRemaining.toFixed(2);
    }
</script>