@model Chapeau.ViewModels.FinancialOverviewViewModel
@using Chapeau.Enums
@section Styles {
    <link rel="stylesheet" href="~/css/financial-overview.css" asp-append-version="true" />
}


<h2 class="page-title mb-2">Financial Overview</h2>
<div class="title-line"></div>

<form method="get" asp-action="Index" class="filter-container">
    <label>Period:</label>
    <select name="period" class="custom-select" id="periodSelect" onchange="toggleDateRange(this.value)">
        <option value="Month" selected="@(Model.Period == FinancialPeriod.Month)">Last Month</option>
        <option value="Quarter" selected="@(Model.Period == FinancialPeriod.Quarter)">Last Quarter</option>
        <option value="Year" selected="@(Model.Period == FinancialPeriod.Year)">Last Year</option>
        <option value="Custom" selected="@(Model.Period == FinancialPeriod.Custom)">Custom Range</option>
    </select>
    <div class="date-range" id="dateRange" style="@(Model.Period == FinancialPeriod.Custom ? "display:flex;" : "display:none;")">
        <label>From:</label>
        <input type="date" name="startDate" class="date-input" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        <label>To:</label>
        <input type="date" name="endDate" class="date-input" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
    </div>

    <button type="submit" class="btn-filter">Show Overview</button>
</form>

<p class="period-label">
    Showing data from <strong>@Model.StartDate.ToString("dd MMM yyyy")</strong>
    to <strong>@Model.EndDate.ToString("dd MMM yyyy")</strong>
</p>

<div class="cards-row">
    <div class="summary-card card-lunch">
        <h3>🥗 Lunch</h3>
        <div class="big-number">€ @Model.Summary.TotalIncomeLunch.ToString("0.00")</div>
        <div class="sub-label">@Model.Summary.TotalSalesLunch orders</div>
    </div>
    <div class="summary-card card-dinner">
        <h3>🍽️ Dinner</h3>
        <div class="big-number">€ @Model.Summary.TotalIncomeDinner.ToString("0.00")</div>
        <div class="sub-label">@Model.Summary.TotalSalesDinner orders</div>
    </div>
    <div class="summary-card card-drinks">
        <h3>🥤 Drinks</h3>
        <div class="big-number">€ @Model.Summary.TotalIncomeDrinks.ToString("0.00")</div>
        <div class="sub-label">@Model.Summary.TotalSalesDrinks orders</div>
    </div>
    <div class="summary-card card-tip">
        <h3>💵 Total Tip</h3>
        <div class="big-number">€ @Model.Summary.TotalTip.ToString("0.00")</div>
        <div class="sub-label">all orders combined</div>
    </div>
</div>

<div class="table-wrapper">
    <table class="menu-table">
        <thead>
            <tr>
                <th>Menu Card</th>
                <th>Total Orders</th>
                <th>Total Income</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>🥗 Lunch</td>
                <td>@Model.Summary.TotalSalesLunch</td>
                <td>€ @Model.Summary.TotalIncomeLunch.ToString("0.00")</td>
            </tr>
            <tr>
                <td>🍽️ Dinner</td>
                <td>@Model.Summary.TotalSalesDinner</td>
                <td>€ @Model.Summary.TotalIncomeDinner.ToString("0.00")</td>
            </tr>
            <tr>
                <td>🥤 Drinks</td>
                <td>@Model.Summary.TotalSalesDrinks</td>
                <td>€ @Model.Summary.TotalIncomeDrinks.ToString("0.00")</td>
            </tr>
            <tr>
                <td>Total</td>
                <td>@Model.Summary.TotalSales</td>
                <td>€ @Model.Summary.TotalIncome.ToString("0.00")</td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    function toggleDateRange(value) {
        var div = document.getElementById('dateRange');
        div.style.display = value === 'Custom' ? 'flex' : 'none';
    }
</script>