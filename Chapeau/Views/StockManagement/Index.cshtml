@using Chapeau.Enums
@model Chapeau.ViewModels.StockManagementViewModel

<style>
    body {
        background-color: #f8f6f3;
        font-family: 'Segoe UI', sans-serif;
        color: #2d2d2d;
    }

    .page-title {
        font-size: 38px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #4b2e1f;
    }

    .title-line {
        height: 2px;
        background-color: #c8a96b;
        width: 100%;
        margin-bottom: 20px;
    }

    .filter-container {
        background: #f4eee7;
        border: 1px solid #d7be95;
        border-radius: 14px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .filter-container label {
            font-weight: 700;
            font-size: 18px;
            color: #4b2e1f;
            margin-bottom: 0;
        }

    .custom-select {
        min-width: 180px;
        height: 44px;
        border-radius: 8px;
        border: 1px solid #c9ab73;
        padding: 0 14px;
        font-size: 16px;
        background-color: white;
        color: #333;
    }

    .btn-filter {
        background-color: #c8a96b;
        border: none;
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 17px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-filter:hover {
            background-color: #b18f4e;
        }

    .table-wrapper {
        overflow-x: auto;
        border-radius: 18px;
    }

    .menu-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 18px;
    }

        .menu-table thead {
            background-color: #6b442b;
            color: white;
        }

        .menu-table th {
            padding: 16px 18px;
            font-size: 18px;
            font-weight: 700;
            text-align: left;
        }

        .menu-table td {
            padding: 14px 18px;
            font-size: 16px;
            border-bottom: 1px solid #ececec;
            vertical-align: middle;
        }

        .menu-table tbody tr:hover {
            background-color: #faf7f2;
        }

    .stock-input {
        width: 90px;
        height: 40px;
        border-radius: 8px;
        border: 1px solid #c9ab73;
        padding: 0 10px;
        font-size: 15px;
        background-color: white;
    }

    .btn-save-stock {
        background-color: #6b442b;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .btn-save-stock:hover {
            background-color: #553520;
        }

    .badge-instock {
        background-color: #d4f4e2;
        color: #1a7a40;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-almostout {
        background-color: #fff3cd;
        color: #856404;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-outofstock {
        background-color: #fde8e8;
        color: #c0392b;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-lunch {
        background-color: #ffe7b3;
        color: #8a5a00;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-dinner {
        background-color: #ffd1d1;
        color: #8a0000;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-drinks {
        background-color: #d1e8ff;
        color: #004a8a;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }
</style>

<h2 class="page-title mb-2">Stock Management</h2>
<div class="title-line"></div>

<form method="get" asp-action="Index" class="filter-container">
    <label>Card:</label>
    <select name="selectedCard" class="custom-select" onchange="this.form.submit()">
        <option value="">All Cards</option>
        @foreach (var card in Enum.GetValues(typeof(Card)))
        {
            <option value="@((int)card)" selected="@(Model.SelectedCard == (Card)card)">@card.ToString()</option>
        }
    </select>

    <label>Category:</label>
    <select name="selectedCategory" class="custom-select" onchange="this.form.submit()">
        <option value="">All Categories</option>
        @foreach (Category category in Model.Categories)
        {
            <option value="@((int)category)" selected="@(Model.SelectedCategory == category)">
                @category.ToString().Replace("CoffeeAndTea", "Coffee & Tea")
            </option>
        }
    </select>
    <button type="submit" class="btn-filter">Filter</button>
</form>

<div class="table-wrapper">
    <table class="menu-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Card</th>
                <th>Category</th>
                <th>Current Stock</th>
                <th>Status</th>
                <th>Update Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menu in Model.Menu)
            {
                @foreach (var item in menu.MenuItems)
                {
                    string badgeClass = menu.Card == Card.Lunch ? "badge-lunch" :
                    menu.Card == Card.Dinner ? "badge-dinner" : "badge-drinks";
                    <tr>
                        <td>@item.MenuItemId</td>
                        <td style="font-weight:600;">@item.MenuItemName</td>
                        <td><span class="@badgeClass">@menu.Card</span></td>
                        <td>@menu.Category</td>
                        <td style="font-weight:600;">@item.Stock</td>
                        <td>
                            @if (item.StockStatus == Chapeau.Enums.StockStatus.OutOfStock)
                            {
                                <span class="badge-outofstock">Out of Stock</span>
                            }
                            else if (item.StockStatus == Chapeau.Enums.StockStatus.AlmostOutOfStock)
                            {

                                <span class="badge-almostout">Almost Out (≤10)</span>
                            }
                            else
                            {

                                <span class="badge-instock">In Stock</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-action="UpdateStock" style="display:flex; gap:8px; align-items:center;">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <input type="hidden" name="selectedCard" value="@((int?)Model.SelectedCard)" />
                                <input type="hidden" name="selectedCategory" value="@((int?)Model.SelectedCategory)" />
                                <input type="number" name="newStock" value="@item.Stock" min="0" class="stock-input" />
                                <button type="submit" class="btn-save-stock">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>