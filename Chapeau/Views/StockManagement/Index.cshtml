@using Chapeau.Enums
@model Chapeau.ViewModels.StockManagementViewModel
@section Styles {
    <link rel="stylesheet" href="~/css/stock-management.css" asp-append-version="true" />
}


<h2 class="page-title mb-2">Stock Management</h2>
<div class="title-line"></div>

<form method="get" asp-action="Index" class="filter-container">
    <label>Card:</label>
    <select name="selectedCard" class="custom-select" onchange="this.form.submit()">
        <option value="">All Cards</option>
        @foreach (var card in Enum.GetValues(typeof(Card)))
        {
            <option value="@((int)card)" selected="@(Model.SelectedCard == (Card)card)">@card.ToString()</option>
        }
    </select>

    <label>Category:</label>
    <select name="selectedCategory" class="custom-select" onchange="this.form.submit()">
        <option value="">All Categories</option>
        @foreach (Category category in Model.Categories)
        {
            <option value="@((int)category)" selected="@(Model.SelectedCategory == category)">
                @category.ToString().Replace("CoffeeAndTea", "Coffee & Tea")
            </option>
        }
    </select>
    <button type="submit" class="btn-filter">Filter</button>
</form>

<div class="table-wrapper">
    <table class="menu-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Card</th>
                <th>Category</th>
                <th>Current Stock</th>
                <th>Status</th>
                <th>Update Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menu in Model.Menu)
            {
                @foreach (var item in menu.MenuItems)
                {
                    string badgeClass = menu.Card == Card.Lunch ? "badge-lunch" :
                    menu.Card == Card.Dinner ? "badge-dinner" : "badge-drinks";
                    <tr>
                        <td>@item.MenuItemId</td>
                        <td style="font-weight:600;">@item.MenuItemName</td>
                        <td><span class="@badgeClass">@menu.Card</span></td>
                        <td>@menu.Category</td>
                        <td style="font-weight:600;">@item.Stock</td>
                        <td>
                            @if (item.StockStatus == Chapeau.Enums.StockStatus.OutOfStock)
                            {
                                <span class="badge-outofstock">Out of Stock</span>
                            }
                            else if (item.StockStatus == Chapeau.Enums.StockStatus.AlmostOutOfStock)
                            {

                                <span class="badge-almostout">Almost Out (≤10)</span>
                            }
                            else
                            {

                                <span class="badge-instock">In Stock</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-action="UpdateStock" style="display:flex; gap:8px; align-items:center;">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <input type="hidden" name="selectedCard" value="@((int?)Model.SelectedCard)" />
                                <input type="hidden" name="selectedCategory" value="@((int?)Model.SelectedCategory)" />
                                <input type="number" name="newStock" value="@item.Stock" min="0" class="stock-input" />
                                <button type="submit" class="btn-save-stock">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>