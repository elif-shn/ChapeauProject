@using Chapeau.Enums
@model Chapeau.ViewModels.MenuViewModel

<style>

    body {
        background-color: #f8f6f3;
        font-family: 'Segoe UI', sans-serif;
        color: #2d2d2d;
    }

    .page-title {
        font-size: 38px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #4b2e1f;
    }

    .title-line {
        height: 2px;
        background-color: #c8a96b;
        width: 100%;
        margin-bottom: 20px;
    }

    .filter-container {
        background: #f4eee7;
        border: 1px solid #d7be95;
        border-radius: 14px;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .filter-container label {
            font-weight: 700;
            font-size: 18px;
            color: #4b2e1f;
            margin-bottom: 0;
        }

    .custom-select, .input-box {
        min-width: 180px;
        height: 44px;
        border-radius: 8px;
        border: 1px solid #c9ab73;
        padding: 0 14px;
        font-size: 16px;
        background-color: white;
        color: #333;
    }

    .btn-filter {
        background-color: #c8a96b;
        border: none;
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 17px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-filter:hover {
            background-color: #b18f4e;
        }

    .btn-add {
        display: inline-block;
        background-color: #6b442b;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 10px;
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 24px;
        transition: 0.2s ease;
    }

        .btn-add:hover {
            background-color: #553520;
        }

    .table-wrapper {
        overflow-x: auto;
        border-radius: 18px;
    }

    .menu-table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 18px;
    }

        .menu-table thead {
            background-color: #6b442b;
            color: white;
        }

        .menu-table th {
            padding: 16px 18px;
            font-size: 18px;
            font-weight: 700;
            text-align: left;
        }

        .menu-table td {
            padding: 16px 18px;
            font-size: 16px;
            border-bottom: 1px solid #ececec;
            vertical-align: middle;
        }

        .menu-table tbody tr:hover {
            background-color: #faf7f2;
        }

    /* ⭐ SLIGHT BLUR FOR INACTIVE ROWS */
    .inactive-row td:not(.actions-cell),
    .inactive-row span:not(.no-blur),
    .inactive-row .menu-badge {
        filter: blur(0.7px) grayscale(40%) brightness(0.95);
    }

    /* ⭐ Buttons stay normal */
    .inactive-row .actions-cell,
    .inactive-row .actions-cell * {
        filter: none !important;
        opacity: 1 !important;
    }

    /* ⭐ BADGES FOR LUNCH / DINNER / DRINKS */
    .badge-lunch {
        background-color: #ffe7b3;
        color: #8a5a00;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-dinner {
        background-color: #ffd1d1;
        color: #8a0000;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-drinks {
        background-color: #d1e8ff;
        color: #004a8a;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-active {
        color: #222;
        font-weight: 500;
    }

    .status-inactive {
        color: #888;
        font-weight: 500;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-edit {
        background-color: #c8a96b;
        color: white;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-deactivate {
        background-color: #d43c2f;
        color: white;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-activate {
        background-color: #22a652;
        color: white;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

</style>

<h2 class="page-title mb-2">Menu Management</h2>
<div class="title-line"></div>

<form method="get" asp-action="Management" class="filter-container">

    <label>All Menus:</label>

    <select name="selectedCard" class="form-select" onchange="this.form.submit()">
        <option value="">All Menus</option>

        @foreach (var card in Enum.GetValues(typeof(Card)))
        {
            <option value="@((int)card)" selected="@(Model.SelectedCard == (Card)card)">
                @card.ToString()
            </option>
        }
    </select>

    <label>Category:</label>

    <select name="selectedCategory" class="form-select" onchange="this.form.submit()">
        <option value="">All Categories</option>
        @foreach (Category category in Model.Categories)
        {
            <option value="@((int)category)" selected="@(Model.SelectedCategory == category)">
                @category.ToString().Replace("CoffeeAndTea", "Coffee & Tea")
            </option>
        }
    </select>

    <button type="submit" class="btn-filter">Filter</button>

</form>

<a asp-action="Add" class="btn-add">+ Add New Menu Item</a>

<div class="table-wrapper">
    <table class="menu-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Card</th>
                <th>Category</th>
                <th>VAT %</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var menu in Model.Menu)
            {
                @foreach (var item in menu.MenuItems)
                {
                    <tr class="@(item.IsActive ? "" : "inactive-row")">
                        <td>@item.MenuItemId</td>
                        <td style="font-weight:600;">@item.MenuItemName</td>

                        <td>€ @item.MenuItemPrice.ToString("0.00")</td>

                        <td>@item.Stock</td>
                        <td>
                            <span class="badge-lunch">@menu.Card</span>
                        </td>
                        <td>@menu.Category</td>
                        <td>@item.VatPercentage %</td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-inactive">Inactive</span>
                            }
                        </td>

                        <td class="actions-cell">
                            <div class="action-buttons">

                                <a asp-action="Edit" asp-route-id="@item.MenuItemId" class="btn-edit">Edit</a>

                                @if (item.IsActive)
                                {
                                    <a asp-action="Deactivate" asp-route-id="@item.MenuItemId" class="btn-deactivate">Deactivate</a>
                                }
                                else
                                {
                                    <a asp-action="Activate" asp-route-id="@item.MenuItemId" class="btn-activate">Activate</a>
                                }

                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>

    </table>
</div>