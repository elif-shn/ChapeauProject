@model Chapeau.ViewModels.MenuManagementViewModel
@using Chapeau.Enums
@section Styles {
    <link rel="stylesheet" href="~/css/menu-management.css" asp-append-version="true" />
}


<h2>Add New Menu Item</h2>
<div class="title-line"></div>

<div class="form-card">

    <form method="post" asp-action="Add">

        <div class="form-group">
            <label>Name</label>
            <input asp-for="ItemToEdit.MenuItemName" class="input-box" required />
        </div>

        <div class="form-group">
            <label>Price (€)</label>
            <input asp-for="ItemToEdit.MenuItemPrice" class="input-box" step="0.01" min="0" required />
        </div>

        <div class="form-group">
            <label>Stock</label>
            <input asp-for="ItemToEdit.Stock" class="input-box" min="0" required />
        </div>

        <select asp-for="SelectedCard" class="input-box" required>
            <option value="">-- Select Card --</option>
            @foreach (Card card in Enum.GetValues(typeof(Card)))
            {
                <option value="@((int)card)">@card</option>
            }
        </select>

        <select asp-for="SelectedCategory" class="input-box" required>
            <option value="">-- Select Category --</option>
            @foreach (Category category in Enum.GetValues(typeof(Category)))
            {
                <option value="@((int)category)">@category</option>
            }
        </select>

        <div class="form-group">
            <label>VAT Percentage</label>
            <input asp-for="ItemToEdit.VatPercentage" class="input-box" min="0" required />
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-save">Add Item</button>
            <a asp-action="Management" class="btn btn-cancel">Cancel</a>
        </div>

    </form>

</div>