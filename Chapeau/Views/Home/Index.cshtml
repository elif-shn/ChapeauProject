@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">Welcome to Chapeau 🍽️</h1>
    <p class="lead text-muted">Your all-in-one restaurant management system</p>
    <hr class="my-4" />
    <div class="row justify-content-center mt-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">🪑 Overview</h5>
                    <p class="card-text text-muted">View and manage all tables</p>
                    <a asp-controller="Tables" asp-action="Index" class="btn btn-outline-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">🍽️ Menu</h5>
                    <p class="card-text text-muted">View the restaurant menu</p>
                    <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">🍴 Kitchen</h5>
                    <p class="card-text text-muted">Manage running kitchen orders</p>
                    <a asp-controller="Order" asp-action="GetRunningKitchenOrders" class="btn btn-outline-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">🍹 Bar </h5>
                    <p class="card-text text-muted">Manage running bar orders</p>
                    <a asp-controller="Order" asp-action="GetRunningBarOrders" class="btn btn-outline-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">💳 Payment</h5>
                    <p class="card-text text-muted">Process table payments</p>
                    <a asp-controller="Payment" asp-action="Index" asp-route-orderId="1" class="btn btn-outline-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">📋 Management</h5>
                    <p class="card-text text-muted">Manage employees, stock, menu &amp; finances</p>
                    <a asp-controller="Home" asp-action="ManagementHub" class="btn btn-outline-primary btn-sm">Go</a>
                </div>
            </div>
        </div>

    </div>
</div>