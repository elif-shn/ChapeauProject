@using Chapeau.Enums
@using Chapeau.Models
@model List<Order>

@{
    ViewData["Title"] = "Running Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Running Orders</h2>
    <div>
        <button onclick="location.reload();" class="btn btn-outline-secondary me-2">Refresh</button>
        <a asp-action="GetFinishedKitchenOrders" class="btn btn-outline-primary">Finished Orders</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No running orders found.</div>
}
else
{
    <div class="row">
        @await Html.PartialAsync("_OrderCardPartial", Model)

        @foreach (Order order in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">

                        @foreach (OrderItem item in order.OrderItems)
                        {
                            <form asp-action="UpdateOrderItemStatus" method="post" class="mt-2">
                                <input type="hidden" name="OrderItemId" value="@item.OrderItemId" />
                                <input type="hidden" name="OrderId" value="@order.OrderId" />
                                <input type="hidden" name="isFood" value="@item.MenuItem.IsFood.ToString().ToLower()" />

                                @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                {
                                    <input type="hidden" name="OrderItemStatus" value="Preparing" />
                                    <button type="submit" class="btn btn-warning btn-sm w-100">
                                        Prepare @item.MenuItem.MenuItemName
                                    </button>
                                }
                                else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                {
                                    <input type="hidden" name="OrderItemStatus" value="Ready" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        @item.MenuItem.MenuItemName Ready
                                    </button>
                                }
                            </form>

                            <form asp-action="UpdateCourseStatus" method="post" class="mt-2">
                                <input type="hidden" name="OrderId" value="@order.OrderId" />
                                <input type="hidden" name="Category" value="@item.MenuItem.Menu.Category" />
                                <input type="hidden" name="isFood" value="@item.MenuItem.IsFood.ToString().ToLower()" />

                                @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                {
                                    <input type="hidden" name="Status" value="Preparing" />
                                    <button type="submit" class="btn btn-warning btn-sm w-100">
                                        Prepare @item.MenuItem.Menu.Category
                                    </button>
                                }
                                else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                {
                                    <input type="hidden" name="Status" value="Ready" />
                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                        @item.MenuItem.Menu.Category Ready
                                    </button>
                                }
                            </form>
                        }

                        <form asp-action="UpdateOrderStatus" method="post" class="mt-3">
                            <input type="hidden" name="OrderId" value="@order.OrderId" />
                            <input type="hidden" name="isFood" value="@order.OrderItems.First().MenuItem.IsFood.ToString().ToLower()" />

                            @if (order.OrderStatus == OrderStatus.Ordered)
                            {
                                <input type="hidden" name="OrderStatus" value="Preparing" />
                                <button type="submit" class="btn btn-warning w-100">Start Preparing Order</button>
                            }
                            else if (order.OrderStatus == OrderStatus.Preparing)
                            {
                                <input type="hidden" name="OrderStatus" value="Ready" />
                                <button type="submit" class="btn btn-success w-100">Ready To Serve Order</button>
                            }
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}