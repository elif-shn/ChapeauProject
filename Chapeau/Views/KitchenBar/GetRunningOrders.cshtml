@using Chapeau.Enums
@using Chapeau.Models
@model List<Order>

@{
    ViewData["Title"] = "Running Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Running @ViewBag.Department Orders</h2>

    <div>
        <button onclick="location.reload();"
                class="btn btn-outline-secondary me-2">
            Refresh
        </button>

        @if (ViewBag.Department == "Kitchen")
        {
            <a asp-action="GetFinishedKitchenOrders"
               class="btn btn-outline-primary">
                Finished Kitchen Orders
            </a>
        }
        else
        {
            <a asp-action="GetFinishedBarOrders"
               class="btn btn-outline-primary">
                Finished Bar Orders
            </a>
        }
    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No running orders found.
    </div>
}
else
{
    <div class="row">

        @foreach (Order order in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow-sm">

                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between">
                            <strong>Table @order.Table.TableId</strong>
                            <strong>Order #@order.OrderId</strong>
                        </div>
                    </div>

                    <div class="card-body">

                        <p>
                            <strong>Waiting:</strong>
                            @((int)order.WaitingTime.TotalMinutes) min
                        </p>

                        <p>
                            <strong>Status:</strong>
                            @order.OrderStatus
                        </p>

                        <hr />

                        @foreach (OrderItem item in order.OrderItems)
                        {
                            <div class="mb-3 border-bottom pb-2">

                                <strong>@item.MenuItem.MenuItemName</strong><br />

                                Category: @item.MenuItem.Menu.Category<br />

                                Quantity: @item.OrderItemQuantity<br />

                                Status: @item.OrderItemStatus

                                <form asp-action="UpdateOrderItemStatus"
                                      method="post"
                                      class="mt-2">

                                    <input type="hidden"
                                           name="OrderItemId"
                                           value="@item.OrderItemId" />

                                    <input type="hidden"
                                           name="OrderId"
                                           value="@order.OrderId" />

                                    @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                    {
                                        <input type="hidden"
                                               name="OrderItemStatus"
                                               value="Preparing" />

                                        <button type="submit"
                                                class="btn btn-warning btn-sm w-100">
                                            Prepare Item
                                        </button>
                                    }
                                    else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                    {
                                        <input type="hidden"
                                               name="OrderItemStatus"
                                               value="Ready" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm w-100">
                                            Item Ready
                                        </button>
                                    }

                                </form>

                                @if (ViewBag.Department == "Kitchen")
                                {
                                    <form asp-action="UpdateCourseStatus"
                                          method="post"
                                          class="mt-2">

                                        <input type="hidden"
                                               name="OrderId"
                                               value="@order.OrderId" />

                                        <input type="hidden"
                                               name="Category"
                                               value="@item.MenuItem.Menu.Category" />

                                        @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                        {
                                            <input type="hidden"
                                                   name="Status"
                                                   value="Preparing" />

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm w-100">
                                                Prepare Course
                                            </button>
                                        }
                                        else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                        {
                                            <input type="hidden"
                                                   name="Status"
                                                   value="Ready" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm w-100">
                                                Course Ready
                                            </button>
                                        }

                                    </form>
                                }

                            </div>
                        }

                        <form asp-action="UpdateOrderStatus"
                              method="post"
                              class="mt-3">

                            <input type="hidden"
                                   name="OrderId"
                                   value="@order.OrderId" />

                            @if (order.OrderStatus == OrderStatus.Ordered)
                            {
                                <input type="hidden"
                                       name="OrderStatus"
                                       value="Preparing" />

                                <button type="submit"
                                        class="btn btn-warning w-100">
                                    Start Preparing Order
                                </button>
                            }
                            else if (order.OrderStatus == OrderStatus.Preparing)
                            {
                                <input type="hidden"
                                       name="OrderStatus"
                                       value="Ready" />

                                <button type="submit"
                                        class="btn btn-success w-100">
                                    Ready To Serve Order
                                </button>
                            }

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}