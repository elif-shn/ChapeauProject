@using Chapeau.Enums
@using Chapeau.Models
@model List<Order>

@{
    ViewData["Title"] = "Running Orders";
    bool isFood = (bool)ViewBag.IsFood;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Running Orders</h2>
    <div>
        <button onclick="location.reload();" class="btn btn-outline-secondary me-2">Refresh</button>
        <a asp-action="@ViewBag.FinishedAction" class="btn btn-outline-primary">Finished Orders</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No running orders found.</div>
}
else
{
    <div class="row">
        @foreach (Order order in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">

                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between">
                            <strong>Table @order.Table.TableId</strong>
                            <strong>Order #@order.OrderId</strong>
                        </div>
                        <small>Order time: @order.OrderTime.ToString("HH:mm")</small><br />
                        <small>Waiting: @((int)order.WaitingTime.TotalMinutes) min</small><br />
                        <small>Status: @order.OrderStatus</small>
                    </div>

                    <div class="card-body">

                        @foreach (IGrouping<Category, OrderItem> courseGroup in order.OrderItems.GroupBy(i => i.MenuItem.Menu.Category))
                        {
                            <h6 class="mt-2 text-uppercase text-muted">@courseGroup.Key</h6>

                            @foreach (OrderItem item in courseGroup)
                            {
                                <div class="mb-3 border-bottom pb-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@item.MenuItem.MenuItemName</strong><br />
                                        Quantity: @item.OrderItemQuantity<br />
                                        Status: @item.OrderItemStatus
                                        @if (!string.IsNullOrEmpty(item.Comment))
                                        {
                                            <br />
                        
                                            <small class="text-muted">Comment: @item.Comment</small>
                                        }
                                    </div>

                                    @if (item.OrderItemStatus != OrderItemStatus.Ready)
                                    {
                                        <form asp-action="UpdateOrderItemStatus" asp-route-isFood="@isFood" method="post">
                                            <input type="hidden" name="OrderItem.OrderItemId" value="@item.OrderItemId" />
                                            <input type="hidden" name="OrderItem.OrderItemStatus" value="@item.OrderItemStatus" />
                                            <input type="hidden" name="Order.OrderId" value="@order.OrderId" />

                                            @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                            {
                                                <button type="submit" class="btn btn-warning btn-sm">Prepare Item</button>
                                            }
                                            else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                            {
                                                <button type="submit" class="btn btn-success btn-sm">Item Ready</button>
                                            }
                                        </form>
                                    }
                                </div>
                            }

                            @* Course button after items *@
                            @if (isFood)
                            {
                                <form asp-action="UpdateCourseStatus" method="post" class="mb-2">
                                    <input type="hidden" name="Order.OrderId" value="@order.OrderId" />
                                    <input type="hidden" name="Category" value="@courseGroup.Key" />

                                    @if (courseGroup.Any(i => i.OrderItemStatus == OrderItemStatus.Ordered))
                                    {
                                        <input type="hidden" name="Status" value="Preparing" />
                                        <button type="submit" class="btn btn-warning btn-sm w-100">Prepare @courseGroup.Key</button>
                                    }
                                    else if (courseGroup.Any(i => i.OrderItemStatus == OrderItemStatus.Preparing))
                                    {
                                        <input type="hidden" name="Status" value="Ready" />
                                        <button type="submit" class="btn btn-success btn-sm w-100">@courseGroup.Key Ready</button>
                                    }
                                </form>
                            }
                        }

                        <form asp-action="UpdateOrderStatus" asp-route-isFood="@isFood" method="post" class="mt-3">
                            <input type="hidden" name="Order.OrderId" value="@order.OrderId" />
                            <input type="hidden" name="Order.OrderStatus" value="@order.OrderStatus" />

                            @if (order.OrderStatus == OrderStatus.Ordered)
                            {
                                <button type="submit" class="btn btn-warning w-100">Start Preparing Order</button>
                            }
                            else if (order.OrderStatus == OrderStatus.Preparing)
                            {
                                <button type="submit" class="btn btn-success w-100">Ready To Serve Order</button>
                            }
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}