@using Chapeau.Enums 
@model Chapeau.ViewModels.MenuViewModel
<style>
    h2 {
        color: #5a3e2b;
        border-bottom: 3px solid #c8a96e;
        padding-bottom: 10px;
    }

    .filter-bar {
        background-color: #fff8f0;
        border: 1px solid #e0c99a;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .filter-bar label {
            font-weight: bold;
            color: #5a3e2b;
        }

        .filter-bar select {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #c8a96e;
            font-size: 0.95rem;
        }

    .btn {
        padding: 8px 18px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.95rem;
        text-decoration: none;
        display: inline-block;
    }

    .btn-filter {
        background-color: #c8a96e;
        color: white;
    }

    .btn-add {
        background-color: #5a3e2b;
        color: white;
        margin-bottom: 15px;
        font-size: 1rem;
        padding: 10px 22px;
    }

    .btn-edit {
        background-color: #c8a96e;
        color: white;
        padding: 5px 12px;
        font-size: 0.85rem;
    }

    .btn-deactivate {
        background-color: #c0392b;
        color: white;
        padding: 5px 12px;
        font-size: 0.85rem;
    }

    .btn-activate {
        background-color: #27ae60;
        color: white;
        padding: 5px 12px;
        font-size: 0.85rem;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    thead {
        background-color: #5a3e2b;
        color: white;
    }

        thead th {
            padding: 14px 16px;
            text-align: left;
        }

    tbody tr {
        border-bottom: 1px solid #f0e6d6;
    }

        tbody tr:hover {
            background-color: #fff8f0;
        }

    tbody td {
        padding: 12px 16px;
    }

    .badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .badge-lunch {
        background-color: #d4f4e2;
        color: #1a7a40;
    }

    .badge-dinner {
        background-color: #fde8d0;
        color: #a85a1a;
    }

    .badge-drinks {
        background-color: #d4edff;
        color: #1a6fa8;
    }

    .inactive-row td {
        color: #999;
        background-color: #f5f5f5;
    }
</style>

<h2>Menu Management</h2>

<form method="get" asp-action="Index" class="filter-bar">
    <label>Menu Card:</label>
    <select name="SelectedMenuId" class="form-select">
        <option value="">All Menus</option>

        @foreach (var menu in Model.Menus)
        {
            <option value="@menu.MenuId" selected="@(Model.SelectedMenuId == menu.MenuId)">
                @menu.MenuName.ToString().ToUpper()
            </option>
        }
    </select>

    <label>Category:</label>
    <select name="SelectedCategory" class="form-select">
        <option value="">All Categories</option>
        @foreach (var category in Model.Categories)
        {
            <option value="@((int)category)"
                    selected="@(Model.SelectedCategory == category)">
                @category.ToString().Replace("CoffeeAndTea", "Coffee & Tea").ToUpper()
            </option>

        }
    </select>
    <button type="submit" class="btn btn-filter">Filter</button>
</form>

<a asp-action="Add" class="btn btn-add">+ Add New Menu Item</a>
<br />
<br />

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Menu</th>
            <th>Category</th>
            <th>VAT %</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.MenuItems)
        {
            string menuLabel = item.Menu.MenuId == 1 ? "Lunch" : item.Menu.MenuId == 2 ? "Dinner" : "Drinks";
            string badgeClass = item.Menu.MenuId == 1 ? "badge-lunch" : item.Menu.MenuId == 2 ? "badge-dinner" : "badge-drinks";
            <tr class="@(item.IsActive ? "" : "inactive-row")">
                <td>@item.MenuItemId</td>
                <td><strong>@item.MenuItemName</strong></td>
                <td>€ @item.MenuItemPrice.ToString("0.00")</td>
                <td>@item.Stock</td>
                <td><span class="badge @badgeClass">@menuLabel</span></td>
                <td>@item.Category.ToString()</td>
                <td>@item.VatPercentage%</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <div class="action-buttons">
                        <a asp-action="Edit" asp-route-id="@item.MenuItemId" class="btn btn-edit">Edit</a>
                        @if (item.IsActive)
                        {
                            <a asp-action="Deactivate" asp-route-id="@item.MenuItemId" class="btn btn-deactivate">Deactivate</a>
                        }
                        else
                        {
                            <a asp-action="Activate" asp-route-id="@item.MenuItemId" class="btn btn-activate">Activate</a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>