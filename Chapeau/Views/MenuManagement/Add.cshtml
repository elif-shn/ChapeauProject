@model Chapeau.ViewModels.MenuManagementViewModel
@using Chapeau.Enums

<style>
    body {
        background-color: #f8f6f3;
        font-family: 'Segoe UI', sans-serif;
        color: #2d2d2d;
    }

    h2 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #4b2e1f;
    }

    .title-line {
        height: 2px;
        background-color: #c8a96b;
        width: 100%;
        margin-bottom: 20px;
    }

    .form-card {
        background-color: #f4eee7;
        border: 1px solid #d7be95;
        border-radius: 16px;
        padding: 28px;
        max-width: 650px;
        margin: auto;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-weight: 700;
            font-size: 17px;
            color: #4b2e1f;
            margin-bottom: 6px;
        }

    .input-box {
        width: 100%;
        height: 46px;
        border-radius: 10px;
        border: 1px solid #c9ab73;
        padding: 0 14px;
        font-size: 16px;
        background-color: white;
        margin-bottom: 10px;
    }

    .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn {
        padding: 12px 26px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-size: 18px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s ease;
    }

    .btn-save {
        background-color: #22a652;
        color: white;
    }

        .btn-save:hover {
            background-color: #1c8d45;
        }

    .btn-cancel {
        background-color: #d43c2f;
        color: white;
    }

        .btn-cancel:hover {
            background-color: #b92e22;
        }
</style>

<h2>Add New Menu Item</h2>
<div class="title-line"></div>

<div class="form-card">
    <form method="post" asp-action="Add">

        <div class="form-group">
            <label>Name</label>
            <input asp-for="ItemToEdit.MenuItemName" class="input-box" required />
        </div>

        <div class="form-group">
            <label>Price (€)</label>
            <input asp-for="ItemToEdit.MenuItemPrice" class="input-box" step="0.01" min="0" required />
        </div>

        <div class="form-group">
            <label>Stock</label>
            <input asp-for="ItemToEdit.Stock" class="input-box" min="0" required />
        </div>

        <div class="form-group">
            <label>Menu Type</label>
            <select asp-for="ItemToEdit.Card" class="input-box">
                @foreach (var card in Model.Cards)
                {
                    <option value="@card">@card</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Category</label>
            <select asp-for="ItemToEdit.Category" class="input-box">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>VAT Percentage</label>
            <input asp-for="ItemToEdit.VatPercentage" class="input-box" min="0" required />
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-save">Add Item</button>
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
        </div>

    </form>
</div>
