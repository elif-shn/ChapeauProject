@model Chapeau.ViewModels.EmployeeManagementViewModel
@using Chapeau.Extensions
@using Chapeau.Models

@{
    Employee? loggedInEmployee = Context.Session.GetObject<Employee>("LoggedInUser");
}

@section Styles {
    <link rel="stylesheet" href="~/css/employee-management.css" asp-append-version="true" />
}

<h2 class="page-title mb-2">Employee Management</h2>
<div class="title-line"></div>

<a asp-action="Add" class="btn-add">+ Add New Employee</a>

<div class="table-wrapper">
    <table class="menu-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Employee Number</th>
                <th>Occupation</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model.Employees)
            {
                <tr class="@(emp.IsActive ? "" : "inactive-row")">
                    <td>@emp.EmployeeId</td>
                    <td style="font-weight:600;">@emp.EmployeeName</td>
                    <td>@emp.EmployeeNumber</td>
                    <td><span class="badge-role">@emp.EmployeeOccupation</span></td>
                    <td>
                        @if (emp.IsActive)
                        {
                            <span class="status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-inactive">Inactive</span>
                        }
                    </td>
                    <td class="actions-cell">
                        <div class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn-edit">Edit</a>

                            @if (emp.IsActive)
                            {
                                if (loggedInEmployee != null && loggedInEmployee.EmployeeId == emp.EmployeeId)
                                {
                                    <button type="button" class="btn-deactivate" disabled>Current User</button>
                                }
                                else
                                {
                                    <form asp-action="Deactivate" asp-route-id="@emp.EmployeeId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-deactivate">Deactivate</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <form asp-action="Activate" asp-route-id="@emp.EmployeeId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-activate">Activate</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>