@model Chapeau.ViewModels.EmployeeManagementViewModel
@using Chapeau.Enums
@section Styles {
    <link rel="stylesheet" href="~/css/employee-management.css" asp-append-version="true" />
}
<h2>Edit Employee</h2>
<div class="title-line"></div>
<div class="form-card">
    <form method="post" asp-action="Edit">
        <input type="hidden" asp-for="EmployeeToEdit.EmployeeId" />
        <div class="form-group">
            <label>Full Name</label>
            <input asp-for="EmployeeToEdit.EmployeeName" class="input-box" required />
        </div>
        <div class="form-group">
            <label>Employee Number</label>
            <input asp-for="EmployeeToEdit.EmployeeNumber" class="input-box" required />
        </div>
        <div class="form-group">
            <label>Occupation / Role</label>
            <select asp-for="EmployeeToEdit.EmployeeOccupation" class="input-box" required>
                <option value="">-- Select Role --</option>
                @foreach (EmployeeRole role in Enum.GetValues(typeof(EmployeeRole)))
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>New Password / PIN Code (leave blank to keep current password)</label>
            <input asp-for="EmployeeToEdit.EmployeePassword" class="input-box" type="password" placeholder="Leave blank to keep current password" />
        </div>
        <div class="btn-row">
            <button type="submit" class="btn btn-save">Save Changes</button>
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
        </div>
    </form>
</div>