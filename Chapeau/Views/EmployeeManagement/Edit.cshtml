@model Chapeau.ViewModels.EmployeeManagementViewModel
<style>
    body {
        background-color: #f8f6f3;
        font-family: 'Segoe UI', sans-serif;
        color: #2d2d2d;
    }

    h2 {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #4b2e1f;
    }

    .title-line {
        height: 2px;
        background-color: #c8a96b;
        width: 100%;
        margin-bottom: 20px;
    }

    .form-card {
        background-color: #f4eee7;
        border: 1px solid #d7be95;
        border-radius: 16px;
        padding: 28px;
        max-width: 650px;
        margin: auto;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-weight: 700;
            font-size: 17px;
            color: #4b2e1f;
            margin-bottom: 6px;
        }

    .input-box {
        width: 100%;
        height: 46px;
        border-radius: 10px;
        border: 1px solid #c9ab73;
        padding: 0 14px;
        font-size: 16px;
        background-color: white;
        margin-bottom: 10px;
    }

    .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn {
        padding: 12px 26px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-size: 18px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s ease;
    }

    .btn-save {
        background-color: #22a652;
        color: white;
    }

        .btn-save:hover {
            background-color: #1c8d45;
        }

    .btn-cancel {
        background-color: #d43c2f;
        color: white;
    }

        .btn-cancel:hover {
            background-color: #b92e22;
        }
</style>
<h2>Edit Employee</h2>
<div class="title-line"></div>
<div class="form-card">
    <form method="post" asp-action="Edit">
        <input type="hidden" asp-for="EmployeeToEdit.EmployeeId" />
        <div class="form-group">
            <label>Full Name</label>
            <input asp-for="EmployeeToEdit.EmployeeName" class="input-box" required />
        </div>
        <div class="form-group">
            <label>Employee Number</label>
            <input asp-for="EmployeeToEdit.EmployeeNumber" class="input-box" required />
        </div>
        <div class="form-group">
            <label>Occupation / Role</label>
            <select asp-for="EmployeeToEdit.EmployeeOccupation" class="input-box" required>
                <option value="">-- Select Role --</option>
                <option value="Manager">Manager</option>
                <option value="Waiter">Waiter</option>
                <option value="Chef">Chef</option>
                <option value="Bartender">Bartender</option>
            </select>
        </div>
        <div class="form-group">
            <label>New Password / PIN Code (leave blank to keep current password)</label>
            <input asp-for="EmployeeToEdit.EmployeePassword" class="input-box" type="password" placeholder="Leave blank to keep current password" />
        </div>
        <div class="btn-row">
            <button type="submit" class="btn btn-save">Save Changes</button>
            <a asp-action="Index" class="btn btn-cancel">Cancel</a>
        </div>
    </form>
</div>