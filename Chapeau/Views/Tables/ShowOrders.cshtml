@using Chapeau.Models
@using Chapeau.Enums
@model List<Chapeau.Models.Order>

<h2>Running Orders</h2>




    @foreach (Order order in Model)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h4>Order #@order.OrderId</h4>
                <p>
                    Status:
                    <strong>@order.OrderStatus</strong>
                </p>
            </div>
            <div>
                @if (order.OrderStatus == OrderStatus.Ready)
                {
                    <form asp-action="MarkServed" method="post">
                        <input type="hidden" name="orderId" value="@order.OrderId" />
                        <input type="hidden" name="tableId" value="@order.TableId" />
                        <button type="submit" class="btn btn-success">Serve</button>
                    </form>
                }
            </div>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (OrderItem item in order.OrderItems)
                    {
                        <tr>
                            <td>@item.MenuItem.MenuItemName</td>
                            <td>@item.OrderItemQuantity</td>
                            <td>@item.OrderItemStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


<a asp-action="Index" class="btn btn-secondary">Back</a>