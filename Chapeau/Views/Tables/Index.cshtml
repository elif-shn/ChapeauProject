@using Chapeau.Enums;
@using Chapeau.Extensions;

@using Chapeau.ViewModels
@model IEnumerable<Chapeau.ViewModels.RestaurantOverviewViewModel>
@{
    var employee = Context.Session.GetObject<Employee>("LoggedInUser");
    bool isWaiter = employee != null && employee.EmployeeOccupation == EmployeeRole.Waiter;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h1>Restaurant Overview</h1>

<a asp-action="Index" class="btn btn-primary mb-3">
    Refresh
</a>

<div class="restaurant-layout">

    @foreach (var item in Model)
    {
        string cssClass =
                item.Table.TableStatus == TableStatus.Occupied
                ? "occupied"
                : "free";

        <div class="table-card @cssClass">

            <h3>Table @item.Table.TableId</h3>

            <p>Capacity: @item.Table.TableCapacity</p>

            <p>Status: @item.Table.TableStatus</p>

            @if (item.Order != null)
            {
                <p>Order Status: @item.Order.OrderStatus</p>
            }
            else
            {
                <p>Order Status: No active order</p>
            }

            @if(item.HasFoodOrders && item.HasDrinkOrders)
            {
                <span class="badge bg-primary">
                    Food & Drink
                </span>
            }
            else if(item.HasFoodOrders)
            {
                <span class="badge bg-success">
                    Food
                </span>
            }
            else if(item.HasDrinkOrders)
            {
                <span class="badge bg-info">
                    Drink
                </span>
            }
            @if (item.HasDrinkOrders)
            {
                <div>
                    <span class="badge bg-info">Drink</span>

                    @if (item.DrinkReady)
                    {
                        <form asp-action="MarkFoodOrDrinkServed" method="post">
                            <input type="hidden" name="orderId" value="@item.Order.OrderId" />
                            <input type="hidden" name="isFood" value="false" />

                            <button class="btn btn-primary btn-sm">
                                Serve Drinks
                            </button>
                        </form>
                    }
                </div>
            }

            @if (item.HasFoodOrders)
            {
                <div>
                    <span class="badge bg-success">Food</span>

                    @if (item.FoodReady)
                    {
                        <form asp-action="MarkFoodOrDrinkServed" method="post">
                            <input type="hidden" name="orderId" value="@item.Order.OrderId" />
                            <input type="hidden" name="isFood" value="true" />

                            <button class="btn btn-success btn-sm">
                                Serve Food
                            </button>
                        </form>
                    }
                </div>
            }

            <form asp-action="ChangeTableStatus"
                  method="post">

                <input type="hidden"
                       name="TableId"
                       value="@item.Table.TableId" />

                <input type="hidden"
                       name="TableCapacity"
                       value="@item.Table.TableCapacity" />

                <input type="hidden"
                       name="TableStatus"
                       value="@item.Table.TableStatus" />

                @if (item.Table.TableStatus ==
                    TableStatus.Free)
                {
                    <button type="submit"
                            class="btn btn-success">

                        Mark Occupied

                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-warning">

                        Mark Free

                    </button>
                }

            </form>

            <a asp-controller="Order"
               asp-action="ViewMenuForTakeOrder"
               asp-route-selectedTableId="@item.Table.TableId"
               class="btn btn-sm btn-primary flex-fill text-center">
                Take Order
            </a>

            <div class="d-flex gap-2 mt-2">
                @if (isWaiter)
                {
                    <a asp-controller="Tables"
                       asp-action="ShowOrders"
                       asp-route-tableId="@item.Table.TableId"
                       class="btn btn-sm btn-primary flex-fill text-center">
                        View Order
                    </a>
                }
                else
                {
                   

                    <span class="btn btn-sm btn-secondary flex-fill text-center disabled">
                        View Order
                    </span>
                }
                

            </div>

        </div>
    }

</div>


