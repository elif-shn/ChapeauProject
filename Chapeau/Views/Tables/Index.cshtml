@using Chapeau.Enums
@using Chapeau.Extensions
@using Chapeau.ViewModels

@model IEnumerable<RestaurantOverviewViewModel>

@{
    var employee = Context.Session.GetObject<Employee>("LoggedInUser");
    bool isWaiter = employee != null &&
                    employee.EmployeeOccupation == EmployeeRole.Waiter;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<h1>Restaurant Overview</h1>

<a asp-action="Index" class="btn btn-primary mb-3">
    Refresh
</a>

<div class="restaurant-layout">

    @foreach (var item in Model)
    {
        string cssClass =
            item.Table.TableStatus == TableStatus.Occupied
            ? "occupied"
            : "free";

        <div class="table-card @cssClass">

            <h3>Table @item.Table.TableId</h3>

            <p>
                <strong>Capacity:</strong>
                @item.Table.TableCapacity
            </p>

            <p>
                <strong>Status:</strong>
                @item.Table.TableStatus
            </p>

            @if (!item.Orders.Any())
            {
                <p>No active orders.</p>
            }
            else
            {
                @foreach (var order in item.Orders)
                {
                    <div class="border rounded p-2 mb-2">

                        <strong>Order #@order.OrderId</strong>

                        @foreach (var orderItem in order.OrderItems)
                        {
                            <div>

                                @orderItem.MenuItem.MenuItemName

                                @if (orderItem.MenuItem.IsFood)
                                {
                                    <span class="badge bg-success">
                                        Food
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info">
                                        Drink
                                    </span>
                                }

                                (@orderItem.OrderItemStatus)

                            </div>
                        }

                        <br />

                        @if (order.OrderItems.Any(i =>
                            !i.MenuItem.IsFood &&
                            i.OrderItemStatus == OrderItemStatus.Ready))
                        {
                            <form asp-action="MarkFoodOrDrinkServed"
                                  method="post">

                                <input type="hidden"
                                       name="orderId"
                                       value="@order.OrderId" />

                                <input type="hidden"
                                       name="isFood"
                                       value="false" />

                                <button class="btn btn-primary btn-sm">
                                    Serve Drinks
                                </button>

                            </form>
                        }

                        @if (order.OrderItems.Any(i =>
                            i.MenuItem.IsFood &&
                            i.OrderItemStatus == OrderItemStatus.Ready))
                        {
                            <form asp-action="MarkFoodOrDrinkServed"
                                  method="post">

                                <input type="hidden"
                                       name="orderId"
                                       value="@order.OrderId" />

                                <input type="hidden"
                                       name="isFood"
                                       value="true" />

                                <button class="btn btn-success btn-sm">
                                    Serve Food
                                </button>

                            </form>
                        }

                    </div>
                }
            }

            <form asp-action="ChangeTableStatus"
                  method="post">

                <input type="hidden"
                       name="TableId"
                       value="@item.Table.TableId" />

                <input type="hidden"
                       name="TableCapacity"
                       value="@item.Table.TableCapacity" />

                <input type="hidden"
                       name="TableStatus"
                       value="@item.Table.TableStatus" />

                @if (item.Table.TableStatus == TableStatus.Free)
                {
                    <button type="submit"
                            class="btn btn-success">
                        Mark Occupied
                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-warning">
                        Mark Free
                    </button>
                }

            </form>

            <br />

            <a asp-controller="Order"
                   asp-action="ViewMenuForTakeOrder"
                   asp-route-selectedTableId="@item.Table.TableId"
                   class="btn btn-primary w-100 mb-2">

                Take Order

            </a>

            @if (isWaiter)
            {
                <a asp-controller="Tables"
                       asp-action="ShowOrders"
                       asp-route-tableId="@item.Table.TableId"
                       class="btn btn-secondary w-100">

                    View Orders

                </a>
            }
            else
            {
                <button class="btn btn-secondary w-100"
                        disabled>

                    View Orders

                </button>
            }

        </div>
    }

</div>


