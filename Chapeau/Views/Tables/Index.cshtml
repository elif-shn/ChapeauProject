@using Chapeau.Enums;
@using Chapeau.Extensions;

@model List<Chapeau.Models.Table>
@{
    var employee = Context.Session.GetObject<Employee>("LoggedInUser");
    bool isWaiter = employee != null && employee.EmployeeOccupation == EmployeeRole.Waiter;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<h1>Restaurant Overview</h1>

<a asp-action="Index" class="btn btn-primary mb-3">
    Refresh
</a>

<div class="restaurant-layout">

    @foreach (var table in Model)
    {
        string cssClass =
            table.TableStatus == TableStatus.Occupied
            ? "occupied"
            : "free";

        <div class="table-card @cssClass">

            <h3>Table @table.TableId</h3>

            <p>Capacity: @table.TableCapacity</p>

            <p>Status: @table.TableStatus</p>

            <form asp-action="ChangeTableStatus"
                  method="post">

                <input type="hidden"
                       name="TableId"
                       value="@table.TableId" />

                <input type="hidden"
                       name="TableCapacity"
                       value="@table.TableCapacity" />

                <input type="hidden"
                       name="TableStatus"
                       value="@table.TableStatus" />

                @if (table.TableStatus ==
                    TableStatus.Free)
                {
                    <button type="submit"
                            class="btn btn-success">

                        Mark Occupied

                    </button>
                }
                else
                {
                    <button type="submit"
                            class="btn btn-warning">

                        Mark Free

                    </button>
                }

            </form>

            <a asp-controller="Order"
               asp-action="ViewMenuForTakeOrder"
               asp-route-selectedTableId="@table.TableId"
               class="btn btn-sm btn-primary flex-fill text-center">
                Take Order
            </a>

            <div class="d-flex gap-2 mt-2">
                @if (isWaiter)
                {
                    <a asp-controller="Tables"
                       asp-action="ShowOrders"
                       asp-route-tableId="@table.TableId"
                       class="btn btn-sm btn-primary flex-fill text-center">
                        View Orders
                    </a>
                }
                else
                {
                   

                    <span class="btn btn-sm btn-secondary flex-fill text-center disabled">
                        View Orders
                    </span>
                }
                

            </div>

        </div>
    }

</div>


