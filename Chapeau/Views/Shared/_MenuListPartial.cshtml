@using Chapeau.Enums
@using Chapeau.Extensions
@model Chapeau.ViewModels.MenuListViewModel

@{
    Card? previousCard = null;
}

<table>
    <tbody>
        @foreach (var menu in Model.MenuFilterData.Menus)
        {
            if (previousCard != menu.Card)
            {
                <tr >
                    <td colspan="4" class="pt-5 pb-2" style="border: none;">
                        <strong>@menu.Card.ToString().ToUpper()</strong>
                    </td>
                </tr>
                previousCard = menu.Card;
            }

            <tr border-spacing: 20px 10px;>
                <td colspan="4" class="pt-3 pb-2" style="border: none;">
                    <em>@menu.Category.ToDisplayName().ToUpper()</em>
                </td>
            </tr>

            @foreach (var item in menu.MenuItems)
            {
                <tr>
                    <td>@item.MenuItemName</td>

                    <td>
                        <span class="@item.StockStatusClass">
                            @item.StockStatus.ToDisplayName()
                        </span>
                    </td>

                    <td>€ @item.MenuItemPrice.ToString("0.00")</td>

                    @if (Model.ShowAddButton)
                    {
                        <td>
                            <form method="post" asp-action="AddItemToCurrentOrder">

                                <input type="hidden" name="MenuFilterData.SelectedTableId" value="@Model.MenuFilterData.SelectedTableId" />
                                <input type="hidden" name="MenuFilterData.SelectedCard" value="@Model.MenuFilterData.SelectedCard" />
                                <input type="hidden" name="MenuFilterData.SelectedCategory" value="@Model.MenuFilterData.SelectedCategory" />

                                <input type="hidden" name="NewOrderItem.MenuItem.MenuItemId" value="@item.MenuItemId" />

                                <button class="btn btn-success">+</button>
                            </form>

                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>