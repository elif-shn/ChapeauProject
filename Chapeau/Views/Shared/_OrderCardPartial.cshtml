@using Chapeau.Enums
@model List<Chapeau.Models.Order>

@foreach (var order in Model)
{
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm">

            <div class="card-header bg-light text-dark">
                <strong>Table @order.Table.TableId</strong>
                <strong>Order #@order.OrderId</strong><br />
                <small>Order time: @order.OrderTime.ToString("HH:mm")</small><br />
                <small>Waiting: @((int)order.WaitingTime.TotalMinutes) min</small><br />
                <small>Status: @order.OrderStatus</small>
            </div>

            <div class="card-body">
                @foreach (var item in order.OrderItems)
                {
                    <div class="mb-3 border-bottom pb-2">
                        <strong>@item.MenuItem.MenuItemName</strong><br />
                        Category: @item.MenuItem.Menu.Category<br />
                        Quantity: @item.OrderItemQuantity<br />
                        Status: @item.OrderItemStatus<br />

                        @if (!string.IsNullOrEmpty(item.Comment))
                        {
                            <small class="text-muted">Comment: @item.Comment</small>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
}