@using Chapeau.Models
@model Order

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light text-dark">
        <div class="d-flex justify-content-between">
            <strong>Table @Model.Table.TableId</strong>
            <strong>Order #@Model.OrderId</strong>
        </div>
    </div>
    <div class="card-body">
        <p><strong>Order Status:</strong> @Model.OrderStatus</p>
        <hr />
        @foreach (var item in Model.OrderItems)
        {
            <div class="mb-2">
                @if (item.MenuItem.Menu != null)
                {
                    <small><strong>Category:</strong> @item.MenuItem.Menu.Category</small>
            
                    <br />
                }
                <strong>@item.MenuItem.MenuItemName</strong><br />
                <span class="text-muted">Quantity: @item.OrderItemQuantity | Status: @item.OrderItemStatus</span>
            </div>
        }
    </div>
</div>