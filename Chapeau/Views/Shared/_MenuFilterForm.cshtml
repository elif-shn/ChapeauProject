@using Chapeau.Enums
@using Chapeau.Extensions
@model Chapeau.ViewModels.MenuListViewModel

<h1 class="display-4 pb-4" style="font-family: Arial, sans-serif; font-weight: 300;">Le MENU</h1>
<form method="get" class="mb-4">
    <div class="row">
        @if (Model.ShowAddButton && Model.SelectedTableId.HasValue)
        {
            <input type="hidden"
                   name="selectedTableId"
                   value="@Model.SelectedTableId" />
        }
        <div class="col-md-4">
            <select name="selectedCard" class="form-select" onchange="this.form.submit()">
                <option value="">All Menus</option>
                @foreach (var card in Enum.GetValues(typeof(Card)))
                {
                    <option value="@((int)card)" selected="@(Model.MenuFilterData.SelectedCard == (Card)card)">
                        @card.ToString()
                    </option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <select name="selectedCategory" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @if (Model.MenuFilterData.Categories != null)
                {
                    @foreach (Category category in Model.MenuFilterData.Categories)
                    {
                        <option value="@((int)category)" selected="@(Model.MenuFilterData.SelectedCategory == category)">
                            @category.ToDisplayName()
                        </option>
                    }
                }
            </select>
        </div>
    </div>
</form>