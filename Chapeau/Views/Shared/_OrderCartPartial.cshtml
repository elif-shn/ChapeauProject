@model Chapeau.ViewModels.TakeOrderViewModel

@if (Model.CurrentOrders.Any())
{
    <table class="table">
        <tbody>
            @foreach (var item in Model.CurrentOrders)
            {
                <tr>
                    <td>
                        @item.MenuItem.MenuItemName

                        <form method="post"
                              asp-action="AddNote"
                              class="d-flex mt-1">

                            <input type="hidden"
                                   name="NewOrderItem.MenuItem.MenuItemId"
                                   value="@item.MenuItem.MenuItemId" />

                            <input type="hidden"
                                   name="SelectedTableId"
                                   value="@Model.SelectedTableId" />

                            <input type="hidden" name="MenuFilterData.SelectedCard" value="@Model.MenuFilterData.SelectedCard" />
                            <input type="hidden" name="MenuFilterData.SelectedCategory" value="@Model.MenuFilterData.SelectedCategory" />

                            <input type="text"
                                   name="NewOrderItem.Comment"
                                   value="@item.Comment"
                                   class="form-control form-control-sm me-1"
                                   placeholder="Add note..." />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-warning">
                                Save
                            </button>
                        </form>
                    </td>

                    <td>
                        <div style="display:inline-flex; align-items:center; gap:6px;">

                            <form method="post"
                                  asp-action="RemoveItemInCurrentOrder"
                                  style="margin:0;">

                                <input type="hidden"
                                       name="NewOrderItem.MenuItem.MenuItemId"
                                       value="@item.MenuItem.MenuItemId" />

                                <input type="hidden"
                                       name="SelectedTableId"
                                       value="@Model.SelectedTableId" />

                                <input type="hidden" name="MenuFilterData.SelectedCard" value="@Model.MenuFilterData.SelectedCard" />
                                <input type="hidden" name="MenuFilterData.SelectedCategory" value="@Model.MenuFilterData.SelectedCategory" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    -
                                </button>
                            </form>

                            <span>
                                @item.OrderItemQuantity
                            </span>

                            <form method="post"
                                  asp-action="AddItemToCurrentOrder"
                                  style="margin:0;">

                                <input type="hidden"
                                       name="NewOrderItem.MenuItem.MenuItemId"
                                       value="@item.MenuItem.MenuItemId" />

                                <input type="hidden"
                                       name="SelectedTableId"
                                       value="@Model.SelectedTableId" />

                                <input type="hidden" name="MenuFilterData.SelectedCard" value="@Model.MenuFilterData.SelectedCard" />
                                <input type="hidden" name="MenuFilterData.SelectedCategory" value="@Model.MenuFilterData.SelectedCategory" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    +
                                </button>
                            </form>

                        </div>

                    </td>

                    <td>
                        @item.Comment
                    </td>

                    <td>
                        <form method="post"
                              asp-action="DeleteItem">

                            <input type="hidden"
                                   name="NewOrderItem.MenuItem.MenuItemId"
                                   value="@item.MenuItem.MenuItemId" />

                            <input type="hidden"
                                   name="SelectedTableId"
                                   value="@Model.SelectedTableId" />

                            <input type="hidden" name="MenuFilterData.SelectedCard" value="@Model.MenuFilterData.SelectedCard" />
                            <input type="hidden" name="MenuFilterData.SelectedCategory" value="@Model.MenuFilterData.SelectedCategory" />

                            <button type="submit"
                                    class="btn btn-sm btn-danger">
                                x
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No items yet</p>
}

<div class="d-flex gap-2">

    <form method="post"
          asp-action="SendOrder"
          class="flex-fill">

        <input type="hidden"
               name="SelectedTableId"
               value="@Model.SelectedTableId" />

        <button class="btn btn-success w-100">
            Send Order
        </button>
    </form>

    <form method="post"
          asp-action="CancelOrder"
          class="flex-fill">

        <input type="hidden"
               name="SelectedTableId"
               value="@Model.SelectedTableId" />

        <button type="submit"
                class="btn btn-danger w-100">
            Cancel
        </button>
    </form>

</div>