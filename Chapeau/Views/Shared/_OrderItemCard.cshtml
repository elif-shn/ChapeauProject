@model Chapeau.Models.OrderItem
@using Chapeau.Enums

<div class="border-bottom pb-2 mb-2">
    <div class="d-flex justify-content-between align-items-start">
        <strong>
            @Model.OrderItemQuantity x @Model.MenuItem.MenuItemName
        </strong>
        @if (Model.OrderItemStatus == OrderItemStatus.Ready)
        {
            <span class="badge bg-success">@Model.OrderItemStatus</span>
        }
        else if (Model.OrderItemStatus == OrderItemStatus.Served)
        {
            <span class="badge bg-secondary">@Model.OrderItemStatus</span>
        }
        else
        {
            <span class="badge bg-secondary">@Model.OrderItemStatus</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Comment))
    {
        <small class="text-muted">Comment: @Model.Comment</small>
    }
</div>
