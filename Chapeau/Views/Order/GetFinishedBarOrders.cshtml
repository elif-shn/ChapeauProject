@model List<Chapeau.Models.Order>

@{
    ViewData["Title"] = "Finished Bar Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Finished Bar Orders</h2>
    <a asp-action="GetRunningBarOrders" class="btn btn-outline-secondary">Back to Running</a>
</div>

<div class="row">
    @foreach (var order in Model)
    {
        <div class="col-md-4">
            @await Html.PartialAsync("_FinishedOrderPartial", order)
        </div>
    }
</div>