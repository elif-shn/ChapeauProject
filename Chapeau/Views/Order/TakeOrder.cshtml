@model Chapeau.ViewModels.TakeOrderViewModel

<partial name="_MenuFilterForm"
         model="new Chapeau.ViewModels.MenuListViewModel
         {
             MenuFilterData = Model.MenuFilterData,
             SelectedTableId = Model.SelectedTableId,
             ShowAddButton = true,
         }" />

<div class="row">
    <div class="col-md-8">

        <partial name="_MenuListPartial"
                 model="new Chapeau.ViewModels.MenuListViewModel
                 {
                     MenuFilterData = Model.MenuFilterData,
                     ShowAddButton = true,
                     SelectedTableId = Model.SelectedTableId
                 }" />

    </div>

    <div class="col-md-4">
        <partial name="Alerts" />
        <partial name="_OrderCartPartial" model="Model" />

    </div>
</div>