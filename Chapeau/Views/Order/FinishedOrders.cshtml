@model List<Chapeau.Models.Order>
@using Chapeau.Enums

@{
    ViewData["Title"] = "Finished Kitchen Orders";


var categoryGroups = new[]
{
    ("Starters", Category.Starters),
    ("Mains", Category.Mains),
    ("Desserts", Category.Desserts)
};


}

<div class="container-fluid">

    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Finished Orders</h1>

        <div>
            <a asp-action="Index" class="btn btn-outline-primary">
                Running Orders
            </a>
        </div>
    </div>

    <div class="row">

        @foreach (var order in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card shadow-sm border h-100">

                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Table @order.Table.TableId</h4>
                        <span class="badge bg-success">
                            @order.OrderStatus
                        </span>
                    </div>

                    <div class="card-body">

                        <p>
                            <strong>Order Time:</strong>
                            @order.OrderTime.ToShortTimeString()
                        </p>

                        @if (order.ServedTime != null)
                        {
                            <p>
                                <strong>Served Time:</strong>
                                @order.ServedTime.Value.ToShortTimeString()
                            </p>
                        }

                        <hr />

                        @foreach (var (label, category) in categoryGroups)
                        {
                            var items = order.OrderItems?
                            .Where(item => item.MenuItem?.Menu?.Category == category)
                            .ToList();

                            if (items == null || !items.Any())
                            {
                                continue;
                            }

                            <h5 class="mt-2">@label</h5>

                            @foreach (var item in items)
                            {
                                @await Html.PartialAsync("_OrderItemCard", item)
                            }
                        }

                    </div>

                </div>

            </div>
        }

    </div>
    

</div>
