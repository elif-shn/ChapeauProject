@model List<Order>
@using Chapeau.Models
@using Chapeau.Enums

@{
    ViewData["Title"] = "Finished Orders";
}

<div class="container mt-4">

    <h1 class="mb-4">Finished Orders</h1>

    <div class="d-flex justify-content-end mb-3">

        <a asp-action="Index"
           class="btn btn-secondary">
            View Orders
        </a>

    </div>

    <div class="table-responsive">

        <table class="table table-hover table-bordered w-100">

            <thead class="table-secondary">
                <tr>
                    <th>Table Number</th>
                    <th>Order Time</th>
                    <th>Waiting Time</th>
                    <th>Status</th>
                    <th>Order Items</th>
                </tr>
            </thead>

            <tbody>

                @foreach (Order order in Model)
                {
                    <tr>

                        <td>@order.Table.TableId</td>

                        <td>@order.OrderTime.ToShortTimeString()</td>

                        <td>@order.WaitingTime</td>

                        <td>

                            @if (order.OrderStatus == OrderStatus.Served)
                            {
                                <span class="badge bg-success">
                                    Served
                                </span>
                            }

                            else if (order.OrderStatus == OrderStatus.Completed)
                            {
                                <span class="badge bg-dark">
                                    Completed
                                </span>
                            }

                        </td>

                        <td>
                            <a asp-controller="Order"
                               asp-action="OrderItems"
                               asp-route-id="@order.OrderId"
                               class="btn btn-sm"
                               style="background-color:darkcyan; border:none; color:white;">
                                View Items
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>