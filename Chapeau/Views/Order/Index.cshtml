@using Chapeau.Models
@using Chapeau.Enums

@{
    ViewData["Title"] = "Running Orders";
    var orders = ((IEnumerable<Order>)Model).OrderBy(o => o.OrderTime);
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Running Orders</h1>

        <div>
            <button class="btn btn-outline-primary"
                    onclick="location.reload()">
                Refresh
            </button>

            <a asp-action="FinishedOrders"
               class="btn btn-outline-secondary">
                Finished Orders
            </a>

            <a asp-action="Bar"
               class="btn btn-outline-info">
                Bar Orders
            </a>
        </div>
    </div>

    <div class="row">

        @foreach (var order in orders)
        {
            if (order.OrderStatus == OrderStatus.Paid ||
            order.OrderStatus == OrderStatus.Cancelled)
            {
                continue;
            }

            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card shadow-sm border h-100">

                    <div class="card-header bg-light">
                        <h4 class="mb-0">
                            Table @order.Table.TableId
                        </h4>
                    </div>

                    <div class="card-body">

                        <p>
                            <strong>Order Time:</strong>
                            @order.OrderTime.ToShortTimeString()
                        </p>

                        <p>
                            <strong>Waiting Time:</strong>
                            @order.WaitingTime
                        </p>

                        <p>
                            <strong>Status:</strong>
                            @order.OrderStatus
                        </p>

                        <hr />

                        <h5>Starters</h5>

                        @foreach (var item in order.OrderItems
                                            .Where(i => i.MenuItem != null &&
                                            i.MenuItem.Menu != null &&
                                            i.MenuItem.Menu.Category == Category.Starters))
                        {
                            <div class="border-bottom pb-2 mb-3">

                                <strong>
                                    @item.OrderItemQuantity x @item.MenuItem.MenuItemName
                                </strong>

                                <br />

                                <small>
                                    Status: @item.OrderItemStatus
                                </small>

                                @if (!string.IsNullOrWhiteSpace(item.Comment))
                                {
                                    <br />
                                    <small>
                                        Comment: @item.Comment
                                    </small>
                                }

                                <br />

                                @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                {
                                    <form asp-action="UpdateOrderItemStatus" method="post">
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <button type="submit"
                                                name="status"
                                                value="Preparing"
                                                class="btn btn-warning btn-sm mt-2">
                                            Start Preparing
                                        </button>
                                    </form>
                                }
                                else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                {
                                    <form asp-action="UpdateOrderItemStatus" method="post">
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <button type="submit"
                                                name="status"
                                                value="Ready"
                                                class="btn btn-success btn-sm mt-2">
                                            Mark Ready
                                        </button>
                                    </form>
                                }

                            </div>
                        }

                        <h5 class="mt-3">Mains</h5>

                        @foreach (var item in order.OrderItems
                                            .Where(i => i.MenuItem != null &&
                                            i.MenuItem.Menu != null &&
                                            i.MenuItem.Menu.Category == Category.Mains))
                        {
                            <div class="border-bottom pb-2 mb-3">

                                <strong>
                                    @item.OrderItemQuantity x @item.MenuItem.MenuItemName
                                </strong>

                                <br />

                                <small>
                                    Status: @item.OrderItemStatus
                                </small>

                                @if (!string.IsNullOrWhiteSpace(item.Comment))
                                {
                                    <br />
                                    <small>
                                        Comment: @item.Comment
                                    </small>
                                }

                                <br />

                                @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                {
                                    <form asp-action="UpdateOrderItemStatus" method="post">
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <button type="submit"
                                                name="status"
                                                value="Preparing"
                                                class="btn btn-warning btn-sm mt-2">
                                            Start Preparing
                                        </button>
                                    </form>
                                }
                                else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                {
                                    <form asp-action="UpdateOrderItemStatus" method="post">
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <button type="submit"
                                                name="status"
                                                value="Ready"
                                                class="btn btn-success btn-sm mt-2">
                                            Mark Ready
                                        </button>
                                    </form>
                                }

                            </div>
                        }

                        <h5 class="mt-3">Desserts</h5>

                        @foreach (var item in order.OrderItems
                                            .Where(i => i.MenuItem != null &&
                                            i.MenuItem.Menu != null &&
                                            i.MenuItem.Menu.Category == Category.Desserts))
                        {
                            <div class="border-bottom pb-2 mb-3">

                                <strong>
                                    @item.OrderItemQuantity x @item.MenuItem.MenuItemName
                                </strong>

                                <br />

                                <small>
                                    Status: @item.OrderItemStatus
                                </small>

                                @if (!string.IsNullOrWhiteSpace(item.Comment))
                                {
                                    <br />
                                    <small>
                                        Comment: @item.Comment
                                    </small>
                                }

                                <br />

                                @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                {
                                    <form asp-action="UpdateOrderItemStatus" method="post">
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <button type="submit"
                                                name="status"
                                                value="Preparing"
                                                class="btn btn-warning btn-sm mt-2">
                                            Start Preparing
                                        </button>
                                    </form>
                                }
                                else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                {
                                    <form asp-action="UpdateOrderItemStatus" method="post">
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <button type="submit"
                                                name="status"
                                                value="Ready"
                                                class="btn btn-success btn-sm mt-2">
                                            Mark Ready
                                        </button>
                                    </form>
                                }

                            </div>
                        }

                        <hr />

                        @if (order.OrderStatus == OrderStatus.Ordered)
                        {
                            <form asp-action="UpdateOrderStatus" method="post">

                                <input type="hidden"
                                       name="orderId"
                                       value="@order.OrderId" />

                                <button type="submit"
                                        name="status"
                                        value="Preparing"
                                        class="btn btn-warning w-100">
                                    Start Preparing
                                </button>

                            </form>
                        }
                        else if (order.OrderStatus == OrderStatus.Preparing)
                        {
                            <form asp-action="UpdateOrderStatus" method="post">

                                <input type="hidden"
                                       name="orderId"
                                       value="@order.OrderId" />

                                <button type="submit"
                                        name="status"
                                        value="Ready"
                                        class="btn btn-success w-100">
                                    Mark Ready
                                </button>

                            </form>
                        }
                        else if (order.OrderStatus == OrderStatus.Ready)
                        {
                            <div class="alert alert-success mb-0">
                                Ready To Serve
                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>
