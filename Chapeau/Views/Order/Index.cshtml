@using Chapeau.ViewModels
@model List<Chapeau.ViewModels.RunningOrderViewModel>

@{
    ViewData["Title"] = "Running Orders";
}

<div class="container-fluid mt-4 bg-white p-4 rounded shadow-sm">

    <h1 class="mb-4">Running Orders</h1>

    <div class="mb-4 text-end">
        <button class="btn btn-success" onclick="location.reload()">
            Refresh Orders
        </button>
    </div>

    <table class="table table-hover table-bordered">

        <thead class="table-secondary">
            <tr>
                <th>Table Number</th>
                <th>Order Time</th>
                <th>Waiting Time</th>
                <th>Status</th>
                <th>Order Item</th>
            </tr>
        </thead>

        <tbody>

            @foreach (RunningOrderViewModel order in Model)
            {
                <tr>
                    <td>@order.Order.Table.TableId</td>

                    <td>@order.Order.OrderTime.ToShortTimeString()</td>

                    <td>@order.WaitingTime</td>

                    <td>@order.Order.OrderStatus</td>

                    <td>
                        <a asp-controller="Order"
                           asp-action="ViewOrderItems"
                           asp-route-id="@order.Order.OrderId"
                           class="btn btn-sm btn-success">

                            View Items
                        </a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>