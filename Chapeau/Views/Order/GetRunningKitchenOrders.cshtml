@using Chapeau.Enums
@using Chapeau.Models
@model List<Order>

@{
    ViewData["Title"] = "Running Kitchen Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Running Kitchen Orders</h2>
    <div>
        <button onclick="location.reload();" class="btn btn-outline-secondary me-2">
            Refresh
        </button>
        <a asp-action="GetFinishedKitchenOrders" class="btn btn-outline-primary">
            Finished Orders
        </a>
    </div>
</div>

<div class="row">
    @foreach (Order order in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between">
                        <strong>Table @order.Table.TableId</strong>
                        <strong>Order #@order.OrderId</strong>
                    </div>
                </div>

                <div class="card-body">
                    <p>
                        <strong>Waiting:</strong> @((int)order.WaitingTime.TotalMinutes) min
                    </p>
                    <p>
                        <strong>Order Status:</strong> @order.OrderStatus
                    </p>
                    <hr />

                    @foreach (OrderItem item in order.OrderItems)
                    {
                        <div class="mb-3">
                            @if (item.MenuItem.Menu != null)
                            {
                                <p class="mb-1"><strong>Course:</strong> @item.MenuItem.Menu.Category</p>
                            }
                            <strong>@item.MenuItem.MenuItemName</strong><br />
                            Quantity: @item.OrderItemQuantity<br />
                            Status: @item.OrderItemStatus

                            @if (item.MenuItem.Menu != null)
                            {
                                <form asp-action="UpdateCourseStatus" method="post" class="mt-2">
                                    <input type="hidden" name="OrderId" value="@order.OrderId" />
                                    <input type="hidden" name="Category" value="@item.MenuItem.Menu.Category" />

                                    @if (item.OrderItemStatus == OrderItemStatus.Ordered)
                                    {
                                        <input type="hidden" name="Status" value="Preparing" />
                                        <button type="submit" class="btn btn-warning btn-sm w-100">
                                            Prepare @item.MenuItem.Menu.Category
                                        </button>
                                    }
                                    else if (item.OrderItemStatus == OrderItemStatus.Preparing)
                                    {
                                        <input type="hidden" name="Status" value="Ready" />
                                        <button type="submit" class="btn btn-success btn-sm w-100">
                                            @item.MenuItem.Menu.Category Ready
                                        </button>
                                    }
                                </form>
                            }
                        </div>
                    }

                    <hr />

                    @if (order.OrderStatus.ToString() == "Ordered")
                    {
                        <form asp-action="UpdateOrderStatus" method="post">
                            <input type="hidden" name="OrderId" value="@order.OrderId" />
                            <input type="hidden" name="OrderStatus" value="Preparing" />
                            <button type="submit" class="btn btn-warning w-100">Prepare Order</button>
                        </form>
                    }
                    else if (order.OrderStatus.ToString() == "Preparing")
                    {
                        <form asp-action="UpdateOrderStatus" method="post">
                            <input type="hidden" name="OrderId" value="@order.OrderId" />
                            <input type="hidden" name="OrderStatus" value="Ready" />
                            <button type="submit" class="btn btn-success w-100">Ready to Serve </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>