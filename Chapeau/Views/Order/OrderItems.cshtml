@model List<OrderItem>

@{
    ViewData["Title"] = "Order Items";
}

<div class="container mt-4 bg-white p-4 rounded shadow-sm">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="fw-bold">Order Items</h1>

        <a asp-controller="Order"
           asp-action="Index"
           class="btn"
           style="background-color:#4A565E; color:white;">
            Back to Orders
        </a>

    </div>

    <table class="table table-hover table-bordered w-100">

        <thead style="background-color:#e9ecef;"
            <tr>
                <th>Course</th>
                <th>Item</th>
                <th>Quantity</th>
                <th>Comment</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.MenuItem.Category
                    </td>

                    <td>
                        @item.MenuItem.MenuItemName
                    </td>

                    <td>
                        @item.OrderItemQuantity
                    </td>

                    <td>
                        @item.Comment
                    </td>

                    <td>
                        @item.OrderItemStatus
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>