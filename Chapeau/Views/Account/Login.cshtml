@model Chapeau.Models.LoginModel

<h2>Login</h2>

<form asp-action="Login"
      method="post">

    <div class="mb-3">

        <label asp-for="Username"></label>

        <input asp-for="Username"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Password"></label>

        <input asp-for="Password"
               type="password"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-primary">

        Login

    </button>

</form>

<p class="text-danger">
    @ViewBag.Error
</p>